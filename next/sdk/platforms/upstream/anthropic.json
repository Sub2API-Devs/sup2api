{
  "baseURL": { "default": "https://api.anthropic.com", "stripSuffixes": ["/v1"] },
  "credentials": {
    "texts": {
      "unsupportedAccountType": "unsupported account type {type} / 不支持的账号类型",
      "keyNotString": "API key must be 8-512 printable characters without spaces / API Key 须为 8-512 个不含空格的可见字符",
      "keyNotStringCode": "pattern",
      "baseURLFormat": "base_url {reason} / base_url 必须是不含账号、查询参数的 http(s) 地址"
    }
  },
  "auth": { "type": "header", "name": "x-api-key", "value": "{api_key}" },
  "headers": {
    "anthropic-version": { "default": "2023-06-01" },
    "content-type": { "set": "application/json" }
  },
  "routes": {
    "anthropic.messages": { "path": "/v1/messages" },
    "anthropic.count_tokens": { "path": "/v1/messages/count_tokens" }
  },
  "defaultProtocol": "anthropic.messages",
  "filterFields": ["service_tier", "inference_geo", "speed"],
  "classify": "anthropic",
  "test": { "protocol": "anthropic.messages", "model": "claude-haiku-4-5", "body": "anthropic.ping" },
  "models": { "path": "/v1/models?limit=1000", "idPath": "data.#.id" }
}
