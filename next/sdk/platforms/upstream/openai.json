{
  "baseURL": { "default": "https://api.openai.com", "stripSuffixes": ["/v1"] },
  "credentials": {
    "keyValidator": { "prefixes": ["sk-", "sess-"], "minLength": 10 },
    "texts": {
      "unsupportedAccountType": "unsupported account type {type} / 不支持的账号类型",
      "keyNotString": "API key must be a string / api_key 必须是字符串",
      "keyNotStringCode": "pattern"
    }
  },
  "auth": { "type": "header", "name": "authorization", "value": "Bearer {api_key}" },
  "headers": {
    "content-type": { "set": "application/json" }
  },
  "routes": {
    "openai.chat": {
      "path": "/v1/chat/completions",
      "patches": [{ "op": "set", "path": "stream_options.include_usage", "value": true, "when": "stream" }]
    },
    "openai.responses": { "path": "/v1/responses" },
    "openai.responses_ws": {
      "path": "/v1/responses",
      "transport": "websocket",
      "headers": { "openai-beta": { "append": "responses_websockets=2026-02-06" } }
    },
    "openai.embeddings": { "path": "/v1/embeddings" }
  },
  "defaultProtocol": "openai.chat",
  "filterFields": ["service_tier", "safety_identifier"],
  "classify": "openai",
  "test": { "protocol": "openai.chat", "model": "gpt-4o-mini", "body": "openai.chat_ping" },
  "models": { "path": "/v1/models", "idPath": "data.#.id" }
}
