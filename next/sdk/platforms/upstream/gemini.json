{
  "baseURL": { "default": "https://generativelanguage.googleapis.com", "stripSuffixes": ["/v1beta", "/v1"] },
  "auth": { "type": "header", "name": "x-goog-api-key", "value": "{api_key}" },
  "headers": {
    "content-type": { "set": "application/json" }
  },
  "routes": {
    "gemini.generate": {
      "path": "/v1beta/models/{model}:generateContent",
      "model": { "from": "meta", "trimPrefix": "models/", "required": true }
    },
    "gemini.stream_generate": {
      "path": "/v1beta/models/{model}:streamGenerateContent?alt=sse",
      "model": { "from": "meta", "trimPrefix": "models/", "required": true }
    },
    "gemini.count_tokens": {
      "path": "/v1beta/models/{model}:countTokens",
      "model": { "from": "meta", "trimPrefix": "models/", "required": true }
    }
  },
  "defaultProtocol": "gemini.generate",
  "filterFields": [],
  "classify": "gemini",
  "test": { "protocol": "gemini.generate", "model": "gemini-2.5-flash-lite", "body": "gemini.ping" },
  "models": { "path": "/v1beta/models?pageSize=1000", "idPath": "models.#.name", "stripPrefix": "models/" }
}
