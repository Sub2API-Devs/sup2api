{
  "id": "anthropic",
  "label": {
    "en": "Anthropic",
    "zh": "Anthropic"
  },
  "endpoints": [
    {
      "id": "messages",
      "method": "POST",
      "path": "/v1/messages",
      "protocol": "anthropic.messages",
      "kind": "proxy",
      "auth": {
        "headers": [
          "x-api-key",
          "authorization"
        ]
      },
      "request": {
        "modelPath": "model",
        "streamPath": "stream",
        "modelReferences": [
          {
            "name": "fallback",
            "arrayPath": "fallbacks",
            "modelPath": "model",
            "parameterOverrides": ["max_tokens", "thinking", "output_config", "speed"]
          },
          {
            "name": "advisor",
            "arrayPath": "tools",
            "match": {"type": "advisor_20260301"},
            "modelPath": "model"
          },
          {
            "name": "advisor",
            "arrayPath": "messages[].content",
            "match": {"type": "tool_addition", "tool.type": "tool_definition", "tool.definition.type": "advisor_20260301"},
            "modelPath": "tool.definition.model"
          },
          {
            "name": "advisor",
            "arrayPath": "messages[].content[].tool_changes",
            "match": {"type": "tool_addition", "tool.type": "tool_definition", "tool.definition.type": "advisor_20260301"},
            "modelPath": "tool.definition.model",
            "identityOnly": true
          }
        ],
        "promptTextPaths": [
          "system",
          "messages.#.content"
        ]
      },
      "response": {
        "stream": "sse",
        "nonStream": "json"
      },
      "errorFormat": "anthropic",
      "billing": "usage",
      "billingTypes": [
        "per_request",
        "per_token",
        "expression"
      ]
    },
    {
      "id": "count_tokens",
      "method": "POST",
      "path": "/v1/messages/count_tokens",
      "protocol": "anthropic.count_tokens",
      "kind": "proxy",
      "auth": {
        "headers": [
          "x-api-key",
          "authorization"
        ]
      },
      "request": {
        "modelPath": "model",
        "modelReferences": [
          {
            "name": "advisor",
            "arrayPath": "tools",
            "match": {"type": "advisor_20260301"},
            "modelPath": "model"
          },
          {
            "name": "advisor",
            "arrayPath": "messages[].content",
            "match": {"type": "tool_addition", "tool.type": "tool_definition", "tool.definition.type": "advisor_20260301"},
            "modelPath": "tool.definition.model"
          },
          {
            "name": "advisor",
            "arrayPath": "messages[].content[].tool_changes",
            "match": {"type": "tool_addition", "tool.type": "tool_definition", "tool.definition.type": "advisor_20260301"},
            "modelPath": "tool.definition.model",
            "identityOnly": true
          }
        ]
      },
      "response": {
        "nonStream": "json"
      },
      "errorFormat": "anthropic",
      "billing": "free"
    }
  ],
  "requestFields": [
    "model"
  ],
  "passHeaders": [
    "anthropic-version",
    "anthropic-beta",
    "anthropic-dangerous-direct-browser-access",
    "user-agent",
    "x-app",
    "x-stainless-arch",
    "x-stainless-helper-method",
    "x-stainless-lang",
    "x-stainless-os",
    "x-stainless-package-version",
    "x-stainless-retry-count",
    "x-stainless-runtime",
    "x-stainless-runtime-version",
    "x-stainless-timeout"
  ],
  "usage": {
    "semantics": "exclusive",
    "attempts": {
      "name": "fallback",
      "adapter": "anthropic_fallback_20260701",
      "requiredBy": ["fallbacks"]
    },
    "sse": [
      {
        "event": "message_start",
        "map": {
          "model": "message.model",
          "input_tokens": "message.usage.input_tokens",
          "cache_read_tokens": "message.usage.cache_read_input_tokens",
          "cache_creation_tokens": "message.usage.cache_creation_input_tokens",
          "cache_creation_1h_tokens": "message.usage.cache_creation.ephemeral_1h_input_tokens",
          "speed": "message.usage.speed",
          "service_tier": "message.usage.service_tier",
          "inference_geo": "message.usage.inference_geo",
          "web_search_requests": "message.usage.server_tool_use.web_search_requests",
          "web_fetch_requests": "message.usage.server_tool_use.web_fetch_requests",
          "code_execution_requests": "message.usage.server_tool_use.code_execution_requests"
        }
      },
      {
        "event": "message_delta",
        "map": {
          "output_tokens": "usage.output_tokens",
          "input_tokens": "usage.input_tokens",
          "cache_read_tokens": "usage.cache_read_input_tokens",
          "cache_creation_tokens": "usage.cache_creation_input_tokens",
          "cache_creation_1h_tokens": "usage.cache_creation.ephemeral_1h_input_tokens",
          "speed": "usage.speed",
          "service_tier": "usage.service_tier",
          "inference_geo": "usage.inference_geo",
          "web_search_requests": "usage.server_tool_use.web_search_requests",
          "web_fetch_requests": "usage.server_tool_use.web_fetch_requests",
          "code_execution_requests": "usage.server_tool_use.code_execution_requests"
        }
      }
    ],
    "facts": {
      "speed": {"type": "enum", "enum": ["standard", "fast"], "path": "usage.speed", "description": {"en": "Actual inference speed", "zh": "实际推理速度"}},
      "service_tier": {"type": "enum", "enum": ["standard", "priority", "batch"], "path": "usage.service_tier", "description": {"en": "Actual service tier", "zh": "实际服务等级"}},
      "inference_geo": {"type": "string", "path": "usage.inference_geo", "description": {"en": "Actual inference geography", "zh": "实际推理地域"}},
      "web_search_requests": {"type": "number", "unit": "request", "path": "usage.server_tool_use.web_search_requests", "description": {"en": "Server web searches", "zh": "服务端搜索次数"}},
      "web_fetch_requests": {"type": "number", "unit": "request", "path": "usage.server_tool_use.web_fetch_requests", "description": {"en": "Server web fetches", "zh": "服务端抓取次数"}},
      "code_execution_requests": {"type": "number", "unit": "request", "path": "usage.server_tool_use.code_execution_requests", "description": {"en": "Server code execution calls (not execution time)", "zh": "服务端代码执行次数（非执行时长）"}}
    },
    "additional": [
      {
        "name": "compaction",
        "jsonPath": "usage.iterations",
        "ssePath": "usage.iterations",
        "sseEvent": "message_delta",
        "typePath": "type",
        "typeValue": "compaction",
        "modelPath": "model",
        "usePrimaryModel": true,
        "requiredBy": ["compaction", "context_management"],
        "semantics": "exclusive",
        "map": {
          "input_tokens": "input_tokens",
          "output_tokens": "output_tokens",
          "cache_read_tokens": "cache_read_input_tokens",
          "cache_creation_tokens": "cache_creation_input_tokens",
          "cache_creation_1h_tokens": "cache_creation.ephemeral_1h_input_tokens"
        }
      },
      {
        "name": "advisor",
        "jsonPath": "usage.iterations",
        "ssePath": "usage.iterations",
        "sseEvent": "message_delta",
        "typePath": "type",
        "typeValue": "advisor_message",
        "modelPath": "model",
        "semantics": "exclusive",
        "map": {
          "input_tokens": "input_tokens",
          "output_tokens": "output_tokens",
          "cache_read_tokens": "cache_read_input_tokens",
          "cache_creation_tokens": "cache_creation_input_tokens",
          "cache_creation_1h_tokens": "cache_creation.ephemeral_1h_input_tokens"
        }
      }
    ],
    "json": {
      "map": {
        "model": "model",
        "input_tokens": "usage.input_tokens",
        "output_tokens": "usage.output_tokens",
        "cache_read_tokens": "usage.cache_read_input_tokens",
        "cache_creation_tokens": "usage.cache_creation_input_tokens",
        "cache_creation_1h_tokens": "usage.cache_creation.ephemeral_1h_input_tokens"
      }
    }
  },
  "stickyRules": [
    {
      "name": "claude-code-session",
      "match": {
        "protocols": [
          "anthropic.messages"
        ],
        "models": [
          "claude-*"
        ]
      },
      "keySources": [
        {
          "type": "body",
          "path": "metadata.user_id"
        }
      ],
      "ttlSeconds": 3600,
      "keyIncludes": [
        "group",
        "model",
        "rule"
      ],
      "onFailure": "failover"
    }
  ]
}
