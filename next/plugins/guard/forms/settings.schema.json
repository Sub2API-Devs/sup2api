{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Guard settings",
  "additionalProperties": false,
  "properties": {
    "webhook_url": {
      "type": "string",
      "title": "Webhook URL",
      "default": "",
      "pattern": "^(https?://\\S+)?$"
    },
    "record_snippets": {
      "type": "boolean",
      "title": "Record matched snippets",
      "default": false
    },
    "alert_cooldown_sec": {
      "type": "integer",
      "title": "Alert cooldown (seconds)",
      "minimum": 0,
      "maximum": 300,
      "default": 60
    }
  }
}
