{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Mailer settings",
  "additionalProperties": false,
  "properties": {
    "host": { "type": "string", "title": "SMTP host", "default": "", "maxLength": 253 },
    "port": { "type": "integer", "title": "Port", "minimum": 1, "maximum": 65535, "default": 587 },
    "security": { "type": "string", "title": "Security", "enum": ["starttls", "tls", "none"], "default": "starttls" },
    "username": { "type": "string", "title": "Username", "default": "", "maxLength": 320 },
    "password": { "type": "string", "title": "Password", "default": "", "maxLength": 1000, "writeOnly": true },
    "from_address": { "type": "string", "title": "From address", "default": "", "maxLength": 320 },
    "from_name": { "type": "string", "title": "From name", "default": "Sub2API", "maxLength": 100 },
    "timeout_seconds": { "type": "integer", "title": "Timeout (seconds)", "minimum": 5, "maximum": 120, "default": 20 }
  }
}
