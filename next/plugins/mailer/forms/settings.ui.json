{
  "ui:order": [
    "host",
    "port",
    "security",
    "username",
    "password",
    "from_address",
    "from_name",
    "timeout_seconds"
  ],
  "host": {
    "ui:title": {
      "en": "SMTP host",
      "zh": "SMTP 服务器"
    },
    "ui:placeholder": "smtp.example.com",
    "ui:help": {
      "en": "Leave empty to stop sending: notifications on the email channel wait and are retried.",
      "zh": "留空则不发送：邮件渠道的通知会等待并重试。"
    }
  },
  "port": {
    "ui:title": {
      "en": "Port",
      "zh": "端口"
    },
    "ui:help": {
      "en": "Usually 587 with STARTTLS, 465 with TLS.",
      "zh": "通常 STARTTLS 用 587，TLS 用 465。"
    }
  },
  "security": {
    "ui:title": {
      "en": "Security",
      "zh": "加密方式"
    },
    "ui:enumNames": [
      {
        "en": "STARTTLS (required)",
        "zh": "STARTTLS（必须支持）"
      },
      {
        "en": "TLS from the start",
        "zh": "全程 TLS"
      },
      {
        "en": "None (only for a local relay)",
        "zh": "不加密（仅限本机中继）"
      }
    ]
  },
  "username": {
    "ui:title": {
      "en": "Username",
      "zh": "用户名"
    },
    "ui:help": {
      "en": "Leave empty when the server needs no login.",
      "zh": "服务器不需要登录时留空。"
    }
  },
  "password": {
    "ui:widget": "secret",
    "ui:title": {
      "en": "Password",
      "zh": "密码"
    },
    "ui:help": {
      "en": "Stored encrypted. Leave empty to keep the stored password.",
      "zh": "加密保存。留空时保留已存储的密码。"
    }
  },
  "from_address": {
    "ui:title": {
      "en": "From address",
      "zh": "发件地址"
    },
    "ui:placeholder": "noreply@example.com"
  },
  "from_name": {
    "ui:title": {
      "en": "From name",
      "zh": "发件人名称"
    }
  },
  "timeout_seconds": {
    "ui:title": {
      "en": "Timeout",
      "zh": "超时"
    },
    "ui:options": {
      "unit": {
        "en": "s",
        "zh": "秒"
      }
    },
    "ui:help": {
      "en": "Longest time one delivery may take, connection included.",
      "zh": "一次投递的最长耗时，包含建立连接。"
    }
  }
}
