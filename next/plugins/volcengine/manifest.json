{
  "apiVersion": 1,
  "key": "volcengine",
  "name": {
    "en": "Volcengine Ark, Doubao Video",
    "zh": "字节火山方舟、豆包视频"
  },
  "description": {
    "en": "Official Volcengine Ark access for OpenAI-compatible APIs, Anthropic Messages, image and video generation, plus configurable Doubao video and asset endpoints. Existing relay text integrations remain compatible. Prices are configured by the administrator.",
    "zh": "提供方舟官方 OpenAI 兼容接口、Anthropic Messages、图片与视频生成，以及可自定义视频和素材端点的豆包视频账号。保留既有中转文本接入兼容，不内置价格。"
  },
  "version": "0.11.1",
  "publisher": "sub2api",
  "icon": "text:V",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.0 <0.2.0",
  "capabilities": [
    {
      "id": "platform.adapter.v1"
    },
    {
      "id": "platform.execute.v1"
    },
    {
      "id": "platform.tasks.v1"
    },
    {
      "id": "platform.poll.v1"
    },
    {
      "id": "platform.monitor.v1"
    },
    {
      "id": "http.routes.v1"
    }
  ],
  "platforms": [
    {
      "id": "volcengine",
      "label": {
        "en": "Volcengine Ark",
        "zh": "火山方舟"
      },
      "requestFields": [
        "model"
      ],
      "passHeaders": [
        "user-agent"
      ],
      "usage": {
        "semantics": "inclusive"
      },
      "endpoints": [
        {
          "id": "images",
          "method": "POST",
          "path": "/ark/v3/images/generations",
          "protocol": "volcengine.images",
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {
            "modelPath": "model",
            "promptTextPaths": [
              "prompt"
            ]
          },
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "usage",
          "usage": {
            "semantics": "inclusive",
            "json": {
              "map": {
                "model": "model",
                "output_tokens": "usage.output_tokens"
              }
            },
            "facts": {
              "images": {
                "type": "number",
                "unit": "image",
                "path": "usage.generated_images",
                "description": {
                  "en": "Images the request generated (usage.generated_images), for price expressions such as u(\"images\") * 0.03",
                  "zh": "本次请求生成的图片张数（usage.generated_images），价格表达式里写 u(\"images\") * 0.03"
                }
              }
            }
          }
        },
        {
          "id": "video_submit",
          "method": "POST",
          "path": "/ark/v3/contents/generations/tasks",
          "protocol": "volcengine.video_submit",
          "task": {
            "action": "submit",
            "kind": "video",
            "idPaths": [
              "id",
              "task_id",
              "data.id",
              "result.id"
            ]
          },
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {
            "modelPath": "model",
            "promptTextPaths": [
              "content.#.text"
            ]
          },
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "usage",
          "usageSource": "plugin",
          "usageRequestFields": [
            "resolution",
            "ratio",
            "duration",
            "frames",
            "content.#",
            "content.0.text",
            "content.1.text",
            "content.2.text"
          ],
          "usage": {
            "semantics": "inclusive",
            "facts": {
              "resolution": {
                "type": "enum",
                "enum": [
                  "480p",
                  "720p",
                  "1080p",
                  "4k"
                ],
                "description": {
                  "en": "Output tier of the clip: the plugin's estimate while the task runs, the tier Ark really rendered once it is reconciled. For tiered price expressions such as tier(u(\"resolution\"), ...)",
                  "zh": "视频的输出档位：任务进行中是插件的预估值，核对完成后是方舟实际渲染的档位。用于分档价格表达式，如 tier(u(\"resolution\"), …)"
                }
              }
            }
          }
        },
        {
          "id": "video_query",
          "method": "GET",
          "path": "/ark/v3/contents/generations/tasks/:task_id",
          "protocol": "volcengine.video_query",
          "task": {
            "action": "query",
            "kind": "video",
            "idParam": "task_id",
            "idPaths": [
              "id",
              "task_id",
              "data.id",
              "result.id"
            ]
          },
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {},
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "free"
        }
      ]
    }
  ],
  "accountTypes": [
    {
      "id": "apikey",
      "label": {
        "en": "Volcengine Ark · Official general",
        "zh": "字节火山方舟 · 官方通用"
      },
      "description": {
        "en": "Use an official Ark API key for OpenAI-compatible APIs, Anthropic Messages and official image/video generation. Messages uses /api/compatible/v1/messages; token counting is not supported. Optional AK/SK credentials enable the official asset library.",
        "zh": "使用官方方舟 API Key 调用 OpenAI 兼容接口、Anthropic Messages、官方图片与豆包视频。Messages 使用 /api/compatible/v1/messages，暂不支持 count_tokens。选填 AK/SK 可启用官方素材库。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": [
        "api_key",
        "secret_key"
      ],
      "settingsFields": [
        "base_url",
        "asset_base_url",
        "asset_region"
      ],
      "guardedSettings": [
        {
          "field": "base_url",
          "allowed": [
            "https://ark.cn-beijing.volces.com",
            "https://ark.ap-southeast.bytepluses.com"
          ]
        },
        {
          "field": "asset_base_url",
          "allowed": [
            "https://ark.cn-beijing.volcengineapi.com"
          ]
        }
      ],
      "platforms": [
        {
          "platform": "openai",
          "passHeaders": [
            "user-agent"
          ]
        },
        {
          "platform": "anthropic",
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "user-agent"
          ],
          "usage": {
            "anthropic.messages": {
              "semantics": "exclusive",
              "sse": [
                {
                  "event": "message_start",
                  "map": {
                    "model": "message.model",
                    "input_tokens": "message.usage.input_tokens",
                    "cache_read_tokens": "message.usage.cache_read_input_tokens",
                    "cache_creation_tokens": "message.usage.cache_creation_input_tokens",
                    "cache_creation_1h_tokens": "message.usage.cache_creation.ephemeral_1h_input_tokens"
                  }
                },
                {
                  "event": "message_delta",
                  "map": {
                    "output_tokens": "usage.output_tokens",
                    "input_tokens": "usage.input_tokens"
                  }
                }
              ],
              "json": {
                "map": {
                  "model": "model",
                  "input_tokens": "usage.input_tokens",
                  "output_tokens": "usage.output_tokens",
                  "cache_read_tokens": "usage.cache_read_input_tokens",
                  "cache_creation_tokens": "usage.cache_creation_input_tokens",
                  "cache_creation_1h_tokens": "usage.cache_creation.ephemeral_1h_input_tokens"
                }
              }
            }
          }
        },
        {
          "platform": "volcengine"
        }
      ]
    },
    {
      "id": "relay",
      "label": {
        "en": "Doubao video",
        "zh": "豆包视频"
      },
      "description": {
        "en": "Use your own base URL, video task collection endpoint and asset library endpoint. API key and optional asset AK/SK are stored separately. Existing OpenAI and Anthropic relay integrations remain compatible.",
        "zh": "自定义 Base URL、视频任务集合端点与素材库端点。API Key 与素材库 AK/SK 分开保存。已有 OpenAI、Anthropic 中转接入保持兼容。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/relay.schema.json",
        "uiSchema": "forms/relay.ui.json"
      },
      "sensitiveFields": [
        "api_key",
        "secret_key"
      ],
      "settingsFields": [
        "base_url",
        "video_endpoint",
        "asset_endpoint",
        "api_prefix",
        "video_api_prefix",
        "asset_base_url",
        "asset_region"
      ],
      "platforms": [
        {
          "platform": "openai",
          "passHeaders": [
            "user-agent"
          ]
        },
        {
          "platform": "anthropic",
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "user-agent"
          ],
          "usage": {
            "anthropic.messages": {
              "semantics": "exclusive",
              "sse": [
                {
                  "event": "message_start",
                  "map": {
                    "model": "message.model",
                    "input_tokens": "message.usage.input_tokens",
                    "cache_read_tokens": "message.usage.cache_read_input_tokens",
                    "cache_creation_tokens": "message.usage.cache_creation_input_tokens",
                    "cache_creation_1h_tokens": "message.usage.cache_creation.ephemeral_1h_input_tokens"
                  }
                },
                {
                  "event": "message_delta",
                  "map": {
                    "output_tokens": "usage.output_tokens",
                    "input_tokens": "usage.input_tokens"
                  }
                }
              ],
              "json": {
                "map": {
                  "model": "model",
                  "input_tokens": "usage.input_tokens",
                  "output_tokens": "usage.output_tokens",
                  "cache_read_tokens": "usage.cache_read_input_tokens",
                  "cache_creation_tokens": "usage.cache_creation_input_tokens",
                  "cache_creation_1h_tokens": "usage.cache_creation.ephemeral_1h_input_tokens"
                }
              }
            }
          }
        },
        {
          "platform": "volcengine"
        }
      ]
    }
  ],
  "database": {
    "schema": "plg_volcengine",
    "migrations": "migrations/"
  },
  "userPermissions": [
    {
      "key": "assets:read",
      "label": {
        "en": "View the Ark asset library",
        "zh": "查看方舟素材库"
      },
      "description": {
        "en": "The asset and asset group pages, and the live listing of what an account holds upstream",
        "zh": "素材与素材组页面，以及账号上游素材的实时列表"
      }
    },
    {
      "key": "assets:manage",
      "label": {
        "en": "Manage the Ark asset library",
        "zh": "管理方舟素材库"
      },
      "description": {
        "en": "Create, rename and delete asset groups and assets on the Volcengine side",
        "zh": "在火山方舟上创建、改名、删除素材组与素材"
      }
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/accounts",
      "scope": "admin",
      "permission": "assets:read"
    },
    {
      "method": "GET",
      "path": "/asset-groups",
      "scope": "admin",
      "permission": "assets:read"
    },
    {
      "method": "POST",
      "path": "/asset-groups",
      "scope": "admin",
      "permission": "assets:manage"
    },
    {
      "method": "GET",
      "path": "/asset-groups/:id",
      "scope": "admin",
      "permission": "assets:read"
    },
    {
      "method": "PATCH",
      "path": "/asset-groups/:id",
      "scope": "admin",
      "permission": "assets:manage"
    },
    {
      "method": "DELETE",
      "path": "/asset-groups/:id",
      "scope": "admin",
      "permission": "assets:manage"
    },
    {
      "method": "GET",
      "path": "/assets",
      "scope": "admin",
      "permission": "assets:read"
    },
    {
      "method": "POST",
      "path": "/assets",
      "scope": "admin",
      "permission": "assets:manage"
    },
    {
      "method": "GET",
      "path": "/assets/:id",
      "scope": "admin",
      "permission": "assets:read"
    },
    {
      "method": "PATCH",
      "path": "/assets/:id",
      "scope": "admin",
      "permission": "assets:manage"
    },
    {
      "method": "DELETE",
      "path": "/assets/:id",
      "scope": "admin",
      "permission": "assets:manage"
    },
    {
      "method": "GET",
      "path": "/accounts/:account_id/upstream/asset-groups",
      "scope": "admin",
      "permission": "assets:read"
    },
    {
      "method": "GET",
      "path": "/accounts/:account_id/upstream/assets",
      "scope": "admin",
      "permission": "assets:read"
    }
  ],
  "ui": {
    "sections": [
      {
        "id": "volcengine",
        "label": {
          "en": "Volcengine Ark",
          "zh": "火山方舟"
        },
        "order": 620
      }
    ],
    "menus": [
      {
        "id": "volcengine-assets",
        "section": "volcengine",
        "label": {
          "en": "Asset library",
          "zh": "素材库"
        },
        "icon": "inbox",
        "page": "assets",
        "permission": "assets:read",
        "order": 100
      },
      {
        "id": "volcengine-asset-groups",
        "section": "volcengine",
        "label": {
          "en": "Asset groups",
          "zh": "素材组"
        },
        "icon": "group",
        "page": "asset_groups",
        "permission": "assets:read",
        "order": 110
      },
      {
        "id": "volcengine-new-asset-group",
        "section": "volcengine",
        "label": {
          "en": "New asset group",
          "zh": "新建素材组"
        },
        "icon": "plus",
        "page": "new_asset_group",
        "permission": "assets:manage",
        "order": 120
      },
      {
        "id": "volcengine-new-asset",
        "section": "volcengine",
        "label": {
          "en": "New asset",
          "zh": "新建素材"
        },
        "icon": "plus",
        "page": "new_asset",
        "permission": "assets:manage",
        "order": 130
      }
    ],
    "pages": {
      "assets": {
        "type": "table",
        "title": {
          "en": "Ark asset library",
          "zh": "方舟素材库"
        },
        "source": "GET /assets",
        "search": "q",
        "columns": [
          {
            "key": "id",
            "label": {
              "en": "#",
              "zh": "#"
            },
            "format": "text"
          },
          {
            "key": "account_name",
            "label": {
              "en": "Account",
              "zh": "账号"
            },
            "format": "text"
          },
          {
            "key": "group_name",
            "label": {
              "en": "Group",
              "zh": "素材组"
            },
            "format": "text"
          },
          {
            "key": "name",
            "label": {
              "en": "Name",
              "zh": "名称"
            },
            "format": "text"
          },
          {
            "key": "asset_type",
            "label": {
              "en": "Type",
              "zh": "类型"
            },
