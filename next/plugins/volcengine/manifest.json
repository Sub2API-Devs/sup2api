  },
  "resources": {
    "memoryMB": 64,
    "cpu": 0.2,
    "maxThreads": 32,
    "maxOpenFiles": 128
  },
  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register the \"Ark API key\" and \"Doubao relay key\" account types and the \"volcengine\" platform",
        "zh": "注册「方舟 API Key」与「豆包中转 Key」账号类型，以及 volcengine 平台"
      }
    },
    {
      "id": "gateway.endpoint",
      "reason": {
        "en": "Serve Ark image generation at POST /ark/v3/images/generations and Doubao Seedance video generation at POST/GET /ark/v3/contents/generations/tasks",
        "zh": "在 POST /ark/v3/images/generations 上提供方舟图片生成，在 POST/GET /ark/v3/contents/generations/tasks 上提供豆包 Seedance 视频生成"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Read the Base URL and API key of Ark API key accounts to build upstream requests, and their asset library access key / secret key to sign asset library calls. Every read of an account's credentials outside gateway traffic is written to the audit log.",
        "zh": "读取方舟 API Key 账号的 Base URL 与 API Key 以构造上游请求，并读取素材库的 Access Key / Secret Key 为素材库调用签名。网关流量之外的每一次凭证读取都会写入审计日志。"
      }
    },
    {
      "id": "accounts.read",
      "reason": {
        "en": "List this plugin's own Ark accounts (names and settings only, never credentials) so the asset library pages can show which account an asset belongs to and which accounts have an asset endpoint configured",
        "zh": "列出本插件自己的方舟账号（只有名称与设置，绝不含凭证），素材库页面才能显示素材属于哪个账号、哪些账号配置了素材端点"
      }
    },
    {
      "id": "db.schema",
      "reason": {
        "en": "Keep the local index of asset groups and assets (account id, Ark id, name, type, status, timestamps) in plg_volcengine, so a list page does not need one signed upstream call - and one audited credential read - per account",
        "zh": "在 plg_volcengine 中保存素材组与素材的本地索引（账号 id、方舟 id、名称、类型、状态、时间），列表页因此不必为每个账号各发一次签名的上游调用、各读一次（会记审计的）凭证"
      }
    },
    {
      "id": "routes.admin",
      "reason": {
        "en": "Serve the asset library APIs under /api/v1/p/volcengine: list, create, update and delete asset groups and assets. Administrators only, behind the plugin's own assets:read / assets:manage permissions.",
        "zh": "在 /api/v1/p/volcengine 下提供素材库接口：素材组与素材的列表、创建、修改、删除。仅管理员可用，并受插件自己的 assets:read / assets:manage 权限约束。"
      }
    },
    {
      "id": "ui.menu",
      "reason": {
        "en": "Add the \"Volcengine Ark\" sidebar group with the asset and asset group pages. These pages are rendered by the console from the manifest (table and form), so the plugin ships no front-end code and does not need ui.native.",
        "zh": "添加「火山方舟」侧边栏分组与素材、素材组页面。这些页面由控制台按 manifest 渲染（table 与 form），插件不带前端代码，因此不需要 ui.native 权限。"
      }
    },
    {
      "id": "net",
      "scope": {
        "domains": [
          "ark.cn-beijing.volcengineapi.com",
          "*.volcengineapi.com"
        ]
      },
      "optional": true,
      "reason": {
        "en": "Call the Ark asset library OpenAPI at the account's asset endpoint - the Ark control plane, a different host from the API Base URL. Only enforced when the egress policy is an allowlist; an account pointed at any other host then needs that host added.",
        "zh": "调用账号的素材端点上的方舟素材库 OpenAPI —— 那是方舟控制面，与 API 的 Base URL 不是同一个主机。仅在出口策略为白名单时生效；账号指向其他主机时需要把该主机加进白名单。"
      }
    }
  ],
  "externalServices": [
    "ark.cn-beijing.volces.com",
    "ark.ap-southeast.bytepluses.com",
    "ark.cn-beijing.volcengineapi.com"
  ]
}
