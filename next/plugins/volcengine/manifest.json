      "asset_groups": {
        "type": "table",
        "title": {
          "en": "Ark asset groups",
          "zh": "方舟素材组"
        },
        "source": "GET /asset-groups",
        "search": "q",
        "columns": [
          {
            "key": "id",
            "label": {
              "en": "#",
              "zh": "#"
            },
            "format": "text"
          },
          {
            "key": "account_name",
            "label": {
              "en": "Account",
              "zh": "账号"
            },
            "format": "text"
          },
          {
            "key": "name",
            "label": {
              "en": "Name",
              "zh": "名称"
            },
            "format": "text"
          },
          {
            "key": "title",
            "label": {
              "en": "Title",
              "zh": "标题"
            },
            "format": "text"
          },
          {
            "key": "group_type",
            "label": {
              "en": "Type",
              "zh": "类型"
            },
            "format": "text"
          },
          {
            "key": "asset_count",
            "label": {
              "en": "Assets",
              "zh": "素材数"
            },
            "format": "number"
          },
          {
            "key": "index_status",
            "label": {
