{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Volcengine Ark API key",
  "required": ["api_key"],
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "pattern": "^(https?://[^\\s?#]+)?$"
    },
    "api_prefix": {
      "type": "string",
      "title": "API path prefix",
      "maxLength": 128,
      "pattern": "^(/|/[^/\\s?#][^\\s?#]*)?$"
    },
    "video_api_prefix": {
      "type": "string",
      "title": "Video API path prefix",
      "maxLength": 128,
      "pattern": "^(/|/[^/\\s?#][^\\s?#]*)?$"
    },
    "access_key": {
      "type": "string",
      "title": "Asset library access key",
      "maxLength": 256,
      "pattern": "^[!-~]*$"
    },
    "secret_key": {
      "type": "string",
      "title": "Asset library secret key",
      "maxLength": 256,
      "pattern": "^[!-~]*$"
    },
    "asset_base_url": {
      "type": "string",
      "title": "Asset endpoint",
      "pattern": "^(https?://[^\\s?#]+)?$"
    },
    "asset_region": {
      "type": "string",
      "title": "Asset region",
      "maxLength": 64,
      "pattern": "^[a-z0-9-]*$"
    }
  }
}
