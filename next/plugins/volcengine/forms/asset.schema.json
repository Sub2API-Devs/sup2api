{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "New Ark asset",
  "required": ["group_id", "url"],
  "additionalProperties": false,
  "properties": {
    "group_id": {
      "type": "integer",
      "title": "Asset group",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "title": "Name",
      "maxLength": 128
    },
    "asset_type": {
      "type": "string",
      "title": "Asset type",
      "maxLength": 64
    },
    "url": {
      "type": "string",
      "title": "URL",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(https?://|tos://)[^\\s]+$"
    }
  }
}
