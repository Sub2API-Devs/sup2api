{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "New Ark asset group",
  "required": ["account_id", "name"],
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "title": "Name",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "title": "Title",
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1024
    },
    "group_type": {
      "type": "string",
      "title": "Group type",
      "default": "AIGC",
      "maxLength": 64
    }
  }
}
