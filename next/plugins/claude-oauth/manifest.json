{
  "apiVersion": 1,
  "key": "claude_oauth",
  "name": {
    "en": "Claude OAuth Accounts",
    "zh": "Claude OAuth 账号"
  },
  "description": {
    "en": "OAuth and setup-token authentication for Claude platform accounts",
    "zh": "Claude 平台的 OAuth 与 setup-token 认证"
  },
  "version": "0.2.2",
  "publisher": "sup2api",
  "icon": "text:CO",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    {
      "id": "platform.adapter.v1"
    },
    {
      "id": "http.routes.v1"
    }
  ],

  "accountTypes": [
    {
      "id": "claude_oauth",
      "label": {
        "en": "Claude OAuth",
        "zh": "Claude OAuth"
      },
      "description": {
        "en": "Full OAuth authorization (org:create_api_key scope)",
        "zh": "完整 OAuth 授权（org:create_api_key 范围）"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/oauth.schema.json"
      },
      "sensitiveFields": [
        "access_token",
        "refresh_token"
      ],
      "settingsFields": [
        "proxy_id"
      ],
      "platforms": [
        {
          "platform": "anthropic"
        }
      ],
      "defaultModels": [
        "claude-fable-5-1",
        "claude-fable-5",
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
        "claude-opus-4-6",
        "claude-opus-4-5",
        "claude-opus-4-5-20251101",
        "claude-sonnet-5-5",
        "claude-sonnet-5",
        "claude-sonnet-4-6",
        "claude-sonnet-4-5",
        "claude-sonnet-4-5-20250929",
        "claude-haiku-4-5",
        "claude-haiku-4-5-20251001",
        "claude-opus-4-20250514",
        "claude-sonnet-4-20250514"
      ],
      "refresh": {},
      "quota": {
        "query": true,
        "headers": [
          {
            "key": "5h",
            "utilization": "anthropic-ratelimit-unified-5h-utilization",
            "reset": "anthropic-ratelimit-unified-5h-reset",
            "status": "anthropic-ratelimit-unified-5h-status"
          },
          {
            "key": "7d",
            "utilization": "anthropic-ratelimit-unified-7d-utilization",
            "reset": "anthropic-ratelimit-unified-7d-reset",
            "status": "anthropic-ratelimit-unified-7d-status"
          },
          {
            "key": "7d_fable",
            "utilization": "anthropic-ratelimit-unified-7d_oi-utilization",
            "reset": "anthropic-ratelimit-unified-7d_oi-reset",
            "status": "anthropic-ratelimit-unified-7d_oi-status"
          }
        ]
      },
      "balance": {
        "currency": "USD"
      }
    },
    {
      "id": "claude_setup_token",
      "label": {
        "en": "Claude Setup Token",
        "zh": "Claude Setup Token"
      },
      "description": {
        "en": "Setup token (inference-only scope)",
        "zh": "Setup token（仅推理范围）"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/setup_token.schema.json"
      },
      "sensitiveFields": [
        "access_token",
        "refresh_token"
      ],
      "settingsFields": [
        "proxy_id"
      ],
      "platforms": [
        {
          "platform": "anthropic"
        }
      ],
      "defaultModels": [
        "claude-fable-5-1",
        "claude-fable-5",
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
        "claude-opus-4-6",
        "claude-opus-4-5",
        "claude-opus-4-5-20251101",
        "claude-sonnet-5-5",
        "claude-sonnet-5",
        "claude-sonnet-4-6",
        "claude-sonnet-4-5",
        "claude-sonnet-4-5-20250929",
        "claude-haiku-4-5",
        "claude-haiku-4-5-20251001",
        "claude-opus-4-20250514",
        "claude-sonnet-4-20250514"
      ],
      "refresh": {},
      "quota": {
        "headers": [
          {
            "key": "5h",
            "utilization": "anthropic-ratelimit-unified-5h-utilization",
            "reset": "anthropic-ratelimit-unified-5h-reset",
            "status": "anthropic-ratelimit-unified-5h-status"
          },
          {
            "key": "7d",
            "utilization": "anthropic-ratelimit-unified-7d-utilization",
            "reset": "anthropic-ratelimit-unified-7d-reset",
            "status": "anthropic-ratelimit-unified-7d-status"
          },
          {
            "key": "7d_fable",
            "utilization": "anthropic-ratelimit-unified-7d_oi-utilization",
            "reset": "anthropic-ratelimit-unified-7d_oi-reset",
            "status": "anthropic-ratelimit-unified-7d_oi-status"
          }
        ]
      }
    }
  ],

  "userPermissions": [
    {
      "key": "claude_oauth:manage",
      "label": {
        "en": "Manage Claude OAuth accounts",
        "zh": "管理 Claude OAuth 账号"
      },
      "description": {
        "en": "Create and manage Claude OAuth accounts",
        "zh": "创建和管理 Claude OAuth 账号"
      }
    }
  ],

  "routes": [
    {
      "method": "POST",
      "path": "/auth/start",
      "scope": "admin",
      "permission": "claude_oauth:manage"
    },
    {
      "method": "POST",
      "path": "/auth/exchange",
      "scope": "admin",
      "permission": "claude_oauth:manage"
    }
  ],

  "resources": {
    "memoryMB": 128,
    "cpu": 0.25,
    "maxThreads": 64,
    "maxOpenFiles": 256
  },

  "hostPermissions": [
    {
      "id": "kv",
      "reason": {
        "en": "Store OAuth session state and access token cache",
        "zh": "存储 OAuth 会话状态和访问令牌缓存"
      }
    },
    {
      "id": "platform.register",
      "reason": {
        "en": "Declare the Claude OAuth and setup-token account types",
        "zh": "声明 Claude OAuth 与 setup-token 账号类型"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Receive the account's tokens to build upstream, quota and token refresh requests",
        "zh": "获取账号令牌，用于构造上游请求、额度查询和令牌刷新请求"
      }
    },
    {
      "id": "routes.admin",
      "reason": {
        "en": "OAuth authorization flow endpoints",
        "zh": "OAuth 授权流程端点"
      }
    },
    {
      "id": "net",
      "scope": {
        "domains": [
          "claude.com",
          "platform.claude.com"
        ]
      },
      "reason": {
        "en": "Exchange the authorization code for tokens when an account is authorized (the host sends token refreshes itself)",
        "zh": "授权账号时用授权码换取令牌（令牌刷新由核心发送）"
      }
    }
  ]
}
