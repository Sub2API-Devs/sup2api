{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["access_token"],
  "properties": {
    "access_token": {
      "type": "string",
      "title": "Access Token",
      "description": "OAuth access token (obtain via authorization flow)",
      "minLength": 1
    },
    "refresh_token": {
      "type": "string",
      "title": "Refresh Token",
      "description": "OAuth refresh token for automatic renewal"
    },
    "expires_at": {
      "type": "integer",
      "title": "Expires At",
      "description": "Token expiration timestamp (Unix seconds)"
    },
    "org_uuid": {
      "type": "string",
      "title": "Organization UUID",
      "description": "Claude organization identifier"
    },
    "account_uuid": {
      "type": "string",
      "title": "Account UUID",
      "description": "Claude account identifier"
    },
    "email_address": {
      "type": "string",
      "title": "Email Address",
      "description": "Account email address",
      "format": "email"
    },
    "proxy_id": {
      "type": "integer",
      "title": "Proxy",
      "description": "Proxy server for upstream requests"
    }
  }
}
