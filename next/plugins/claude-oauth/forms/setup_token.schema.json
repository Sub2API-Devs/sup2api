{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["access_token"],
  "properties": {
    "access_token": {
      "type": "string",
      "title": "Access Token",
      "description": "Setup token (inference-only scope)",
      "minLength": 1
    },
    "refresh_token": {
      "type": "string",
      "title": "Refresh Token",
      "description": "OAuth refresh token for automatic renewal"
    },
    "expires_at": {
      "type": "integer",
      "title": "Expires At",
      "description": "Token expiration timestamp (Unix seconds)"
    },
    "proxy_id": {
      "type": "integer",
      "title": "Proxy",
      "description": "Proxy server for upstream requests"
    }
  }
}
