{
  "apiVersion": 1,
  "key": "openai",
  "name": { "en": "OpenAI", "zh": "OpenAI" },
  "description": {
    "en": "OpenAI API key account type and default model prices. The openai platform and its endpoints (/v1/chat/completions, /v1/responses, /v1/embeddings) are built into the core. Default prices are examples; OpenAI's official pricing prevails.",
    "zh": "OpenAI API Key 账号类型与默认价格（openai 平台及其端点 /v1/chat/completions、/v1/responses、/v1/embeddings 由核心内置）。默认价格仅为示例，以 OpenAI 官方公布价格为准。"
  },
  "version": "0.1.1",
  "publisher": "sub2api",
  "icon": "text:O",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    { "id": "platform.adapter.v1" }
  ],

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "API Key", "zh": "API Key" },
      "description": {
        "en": "An OpenAI Platform API key, or a key for an OpenAI-compatible endpoint (set Base URL).",
        "zh": "OpenAI 平台的 API Key，或 OpenAI 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url", "model_mapping"],
      "platforms": [
        { "platform": "openai" }
      ]
    }
  ],

  "pricing": [
