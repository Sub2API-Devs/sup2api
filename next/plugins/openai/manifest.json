{
  "apiVersion": 1,
  "key": "openai",
  "name": { "en": "OpenAI", "zh": "OpenAI" },
  "description": {
    "en": "OpenAI API key account type. The openai platform and its endpoints (/v1/chat/completions, /v1/responses including its WebSocket mode, /v1/embeddings) are built into the core; model prices are set by administrators in the core.",
    "zh": "OpenAI API Key 账号类型（openai 平台及其端点 /v1/chat/completions、/v1/responses（含 WebSocket 模式）、/v1/embeddings 由核心内置；模型价格由管理员在核心中配置）。"
  },
  "version": "0.3.3",
  "publisher": "sub2api",
  "icon": "assets/openai.svg",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    { "id": "platform.adapter.v1" },
    { "id": "platform.execute.v1" },
    { "id": "platform.websocket.v1" }
  ],

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "OpenAI", "zh": "OpenAI" },
      "description": {
        "en": "An OpenAI Platform API key, or a key for an OpenAI-compatible endpoint (set Base URL).",
        "zh": "OpenAI 平台的 API Key，或 OpenAI 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url"],
      "guardedSettings": [
        { "field": "base_url", "allowed": ["https://api.openai.com"] }
      ],
      "defaultModels": [
        "gpt-6-astra",
        "gpt-5.4",
        "gpt-5.4-2026-03-05",
        "gpt-5.4-pro",
        "gpt-5.4-pro-2026-03-05",
        "gpt-5.3-chat-latest",
        "gpt-5.3-codex",
        "gpt-5.2",
        "gpt-5.2-2025-12-11",
        "gpt-5.2-chat-latest",
        "gpt-5.2-pro",
        "gpt-5.2-pro-2025-12-11",
        "gpt-5.2-codex",
        "gpt-5.1",
        "gpt-5.1-2025-11-13",
        "gpt-5.1-chat-latest",
        "gpt-5.1-codex",
        "gpt-5.1-codex-mini",
        "gpt-5.1-codex-max",
        "gpt-5",
        "gpt-5-2025-08-07",
        "gpt-5-chat-latest",
        "gpt-5-mini",
        "gpt-5-mini-2025-08-07",
        "gpt-5-nano",
        "gpt-5-nano-2025-08-07",
        "gpt-5-codex",
        "gpt-5-pro",
        "gpt-5-pro-2025-10-06",
        "gpt-5-search-api",
        "gpt-5-search-api-2025-10-14",
        "gpt-4.1",
        "gpt-4.1-2025-04-14",
        "gpt-4.1-mini",
        "gpt-4.1-mini-2025-04-14",
        "gpt-4.1-nano",
        "gpt-4.1-nano-2025-04-14",
        "gpt-4o",
        "gpt-4o-2024-05-13",
        "gpt-4o-2024-08-06",
        "gpt-4o-2024-11-20",
        "chatgpt-4o-latest",
        "gpt-4o-mini",
        "gpt-4o-mini-2024-07-18",
        "gpt-4o-search-preview",
        "gpt-4o-mini-search-preview",
        "o1",
        "o1-2024-12-17",
        "o1-pro",
        "o1-pro-2025-03-19",
        "o3",
        "o3-2025-04-16",
        "o3-pro",
        "o3-pro-2025-06-10",
        "o3-mini",
        "o3-mini-2025-01-31",
        "o3-deep-research",
        "o3-deep-research-2025-06-26",
        "o4-mini",
        "o4-mini-2025-04-16",
        "o4-mini-deep-research",
        "o4-mini-deep-research-2025-06-26",
        "gpt-4-turbo",
        "gpt-4-turbo-2024-04-09",
        "gpt-4",
        "gpt-3.5-turbo",
        "computer-use-preview",
        "computer-use-preview-2025-03-11",
        "text-embedding-3-small",
        "text-embedding-3-large",
        "text-embedding-ada-002",
        "gpt-4.5-preview",
        "gpt-4.5-preview-2025-02-27",
        "o1-preview",
        "o1-mini"
      ],
      "defaultModelMapping": {
        "gpt-4.5-preview": "gpt-4.1",
        "gpt-4.5-preview-2025-02-27": "gpt-4.1-2025-04-14",
        "o1-preview": "o1",
        "o1-mini": "o3-mini"
      },
      "platforms": [
        { "platform": "openai" }
      ]
    }
  ],

  "resources": { "memoryMB": 32, "cpu": 0.1, "maxThreads": 32, "maxOpenFiles": 64 },

  "hostPermissions": [
    { "id": "platform.register",
      "reason": { "en": "Register the OpenAI API key account type for the built-in openai platform", "zh": "为内置 openai 平台注册 OpenAI API Key 账号类型" } },
    { "id": "accounts.credentials", "scope": { "types": "own" },
      "reason": { "en": "Read the API key of accounts of its own account type (OpenAI API Key) to call the upstream API", "zh": "读取本插件账号类型（OpenAI API Key）账号的 API Key 以调用上游接口" } }
  ],

  "externalServices": ["api.openai.com"]
}
