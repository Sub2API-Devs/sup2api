{
  "apiVersion": 1,
  "key": "payment",
  "name": { "en": "Payment & Recharge", "zh": "充值支付" },
  "description": {
    "en": "Online recharge orders, redeem codes and promo codes. Balance is credited through the host ledger.",
    "zh": "在线充值订单、兑换码与优惠码，余额通过核心账本入账。"
  },
  "version": "0.1.0",
  "publisher": "sub2api",
  "icon": "text:P",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    { "id": "http.routes.v1" }
  ],

  "database": { "schema": "plg_payment", "migrations": "migrations/" },

  "userPermissions": [
    {
      "key": "recharge:use",
      "label": { "en": "Recharge and redeem", "zh": "充值与兑换" },
      "description": { "en": "Create recharge orders, view own orders and redeem codes", "zh": "创建充值订单、查看自己的订单、使用兑换码" }
    },
    {
      "key": "config:manage",
      "label": { "en": "Manage payment configuration", "zh": "管理支付配置" },
      "description": { "en": "Payment settings, providers, redeem codes and promo codes", "zh": "支付设置、支付渠道、兑换码与优惠码" },
      "sensitive": true
    }
  ],

  "routes": [
    { "method": "POST", "path": "/orders", "scope": "user", "permission": "recharge:use" },
    { "method": "GET", "path": "/orders", "scope": "user", "permission": "recharge:use" },
    { "method": "POST", "path": "/redeem", "scope": "user", "permission": "recharge:use" },
    { "method": "GET", "path": "/redeem/history", "scope": "user", "permission": "recharge:use" },

    { "method": "POST", "path": "/webhook/:provider", "scope": "webhook" },

    { "method": "GET", "path": "/config", "scope": "admin", "permission": "config:manage" },
    { "method": "PUT", "path": "/config", "scope": "admin", "permission": "config:manage" },
    { "method": "GET", "path": "/providers", "scope": "admin", "permission": "config:manage" },
    { "method": "POST", "path": "/providers", "scope": "admin", "permission": "config:manage" },
    { "method": "GET", "path": "/redeem-codes", "scope": "admin", "permission": "config:manage" },
    { "method": "POST", "path": "/redeem-codes", "scope": "admin", "permission": "config:manage" },
    { "method": "DELETE", "path": "/redeem-codes/:id", "scope": "admin", "permission": "config:manage" },
    { "method": "GET", "path": "/promo-codes", "scope": "admin", "permission": "config:manage" },
    { "method": "POST", "path": "/promo-codes", "scope": "admin", "permission": "config:manage" },
    { "method": "PATCH", "path": "/promo-codes/:id", "scope": "admin", "permission": "config:manage" },
    { "method": "DELETE", "path": "/promo-codes/:id", "scope": "admin", "permission": "config:manage" }
  ],

  "resources": { "memoryMB": 128, "cpu": 0.25, "maxThreads": 64, "maxOpenFiles": 256 },

  "hostPermissions": [
    {
      "id": "db.schema",
      "reason": { "en": "Store orders, provider settings, redeem codes and promo codes", "zh": "存储订单、支付渠道配置、兑换码与优惠码" }
    },
    {
      "id": "routes.user",
      "reason": { "en": "Recharge, order and redeem APIs for users", "zh": "用户充值、订单与兑换接口" }
    },
    {
      "id": "routes.admin",
      "reason": { "en": "Payment configuration and code management APIs", "zh": "支付配置与兑换码/优惠码管理接口" }
    },
    {
      "id": "routes.webhook",
      "reason": { "en": "Receive payment provider callbacks", "zh": "接收支付渠道回调" }
    },
    {
      "id": "ledger.credit",
      "scope": { "maxPerTx": "100000", "maxPerDay": "1000000" },
      "reason": { "en": "Credit paid orders, redeem codes and promo bonuses to user balance (max 100000/tx, 1000000/day)", "zh": "支付成功的订单、兑换码与优惠码赠送入账（单次最多 100000、单日最多 1000000）" }
    }
  ]
}
