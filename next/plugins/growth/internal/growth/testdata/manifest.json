{
  "apiVersion": 1,
  "key": "growth",
  "name": { "en": "Growth & Engagement", "zh": "用户增长" },
  "description": {
    "en": "Referral rewards and daily check-in. Invitees' usage/recharge triggers commission credited to the inviter's balance. Daily check-in awards random quota.",
    "zh": "邀请返利与每日签到。被邀请人消费或充值后按比例返利给邀请人；每日签到获得随机额度奖励。"
  },
  "version": "0.1.0",
  "publisher": "sub2api",
  "icon": "text:G",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.0 <0.2.0",
  "hostUICompat": "^1.0",

  "capabilities": [
    { "id": "app.events.v1" },
    { "id": "app.jobs.v1" },
    { "id": "http.routes.v1" }
  ],

  "events": {
    "subscribe": ["usage.recorded", "balance.changed", "user.created"],
    "batchSize": 50
  },

  "jobs": [
    { "id": "cleanup", "schedule": "0 3 * * *", "timeoutSec": 600 }
  ],

  "database": { "schema": "plg_growth", "migrations": "migrations/" },

  "userPermissions": [
    {
      "key": "growth:read",
      "label": { "en": "View growth stats", "zh": "查看增长统计" },
      "description": { "en": "Referral and check-in records", "zh": "邀请返利与签到记录" }
    },
    {
      "key": "growth:manage",
      "label": { "en": "Manage growth settings", "zh": "管理增长设置" },
      "description": { "en": "Configure rates, limits and view all users' data", "zh": "配置比例、限额并查看所有用户数据" },
      "sensitive": true
    }
  ],

  "routes": [
    { "method": "GET", "path": "/me/referral", "scope": "user", "permission": "growth:read" },
    { "method": "POST", "path": "/me/referral/bind", "scope": "user", "permission": "growth:read" },
    { "method": "GET", "path": "/me/checkin/status", "scope": "user", "permission": "growth:read" },
    { "method": "POST", "path": "/me/checkin", "scope": "user", "permission": "growth:read" },
    { "method": "GET", "path": "/admin/referrals", "scope": "admin", "permission": "growth:manage" },
    { "method": "GET", "path": "/admin/referrals/:user_id", "scope": "admin", "permission": "growth:manage" },
    { "method": "GET", "path": "/admin/commissions", "scope": "admin", "permission": "growth:manage" },
    { "method": "GET", "path": "/admin/checkins", "scope": "admin", "permission": "growth:manage" },
    { "method": "GET", "path": "/admin/stats", "scope": "admin", "permission": "growth:manage" }
  ],

  "ui": {
    "sections": [
      { "id": "growth", "label": { "en": "Growth", "zh": "增长" }, "order": 250 }
    ],
    "menus": [
      {
        "id": "my-referral",
        "section": "me",
        "label": { "en": "My Referrals", "zh": "我的邀请" },
        "icon": "user",
        "page": "my-referral",
        "permission": "growth:read",
        "order": 110
      },
      {
        "id": "checkin",
        "section": "me",
        "label": { "en": "Daily Check-in", "zh": "每日签到" },
        "icon": "clock",
        "page": "checkin",
        "permission": "growth:read",
        "order": 120
      },
      {
        "id": "growth-admin",
        "section": "growth",
        "label": { "en": "Growth Dashboard", "zh": "增长管理" },
        "icon": "chart",
        "page": "admin",
        "permission": "growth:manage",
        "order": 10
      }
    ],
    "pages": {
      "my-referral": {
        "type": "native",
        "title": { "en": "My Referrals", "zh": "我的邀请" },
        "component": "MyReferral"
      },
      "checkin": {
        "type": "native",
        "title": { "en": "Daily Check-in", "zh": "每日签到" },
        "component": "Checkin"
      },
      "admin": {
        "type": "native",
        "title": { "en": "Growth Dashboard", "zh": "增长管理" },
        "component": "GrowthAdmin"
      }
    },
    "native": { "entry": "ui/native/entry.js" },
    "settings": {
      "mode": "schema",
      "schema": "forms/settings.schema.json",
      "uiSchema": "forms/settings.ui.json"
    }
  },

  "resources": { "memoryMB": 128, "cpu": 0.25, "maxThreads": 64, "maxOpenFiles": 256 },

  "hostPermissions": [
    {
      "id": "db.schema",
      "reason": { "en": "Store referral codes, commissions and check-in records", "zh": "存储邀请码、返利记录和签到记录" }
    },
    {
      "id": "events",
      "scope": { "subscribe": ["usage.recorded", "balance.changed", "user.created"] },
      "reason": { "en": "Trigger commission on usage/recharge and generate referral codes for new users", "zh": "消费/充值时触发返利，新用户注册时生成邀请码" }
    },
    {
      "id": "jobs",
      "reason": { "en": "Clean up old check-in records daily", "zh": "每日清理过期签到记录" }
    },
    {
      "id": "routes.user",
      "reason": { "en": "User referral and check-in APIs", "zh": "用户邀请与签到接口" }
    },
    {
      "id": "routes.admin",
      "reason": { "en": "Admin dashboard APIs", "zh": "管理后台接口" }
    },
    {
      "id": "ui.menu",
      "reason": { "en": "Add growth menus", "zh": "添加增长菜单" }
    },
    {
      "id": "ui.native",
      "reason": { "en": "Provide console UI pages", "zh": "提供控制台页面" }
    },
    {
      "id": "ledger.credit",
      "scope": { "maxPerTx": "10", "maxPerDay": "100" },
      "reason": { "en": "Credit referral commission and check-in rewards to user balance (max $10/tx, $100/day)", "zh": "返利和签到奖励入账（单次最多 $10、单日最多 $100）" }
    }
  ]
}
