{
  "apiVersion": 1,
  "key": "moderation",
  "name": {
    "en": "Prompt Moderation",
    "zh": "提示词审核"
  },
  "description": {
    "en": "Moderates gateway requests with flows of auditors (OpenAI moderation, TypeSafe Jev, LLM verdict) bound to groups and accounts. Users on the always-check-first list and users at the enforce level are moderated before the upstream call and refused on a hit: a watch-list entry's own level decides, and without an entry the default level does - enforce when the mode is enforce, so then everyone without an entry is moderated first. Users on the background-only list and all other requests are moderated in the background. Suspicious users join the watch list automatically; repeated violations can ban them. The cost of every moderation call is shown with the core model prices.",
    "zh": "按分组、分组下的账号或账号绑定的审核流程（OpenAI 内容审核、TypeSafe Jev、大模型判定）审核网关请求。“总是先审”名单的用户和拦截级的用户先审后发、命中即拒绝：有名单条目的按条目自己的级别，没有条目的按默认级别——模式为拦截时默认级别就是拦截级，此时所有没有条目的用户都先审。“只后台审核”名单的用户和其余请求在后台审核。可疑用户自动进入观察名单，多次违规可自动封禁。每次审核调用的费用按核心的模型价格展示。"
  },
  "version": "0.10.0",
  "publisher": "sub2api",
  "icon": "text:M",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.280 <0.2.0",
  "hostUICompat": "^3.12",
  "capabilities": [
    {
      "id": "gateway.hook.v1"
    },
    {
      "id": "app.jobs.v1"
    },
    {
      "id": "app.broadcast.v1"
    },
    {
      "id": "http.routes.v1"
    }
  ],
  "hooks": [
    {
      "id": "ban",
      "point": "gateway.request",
      "order": 199,
      "timeoutMs": 2000,
      "failure": "open"
    },
    {
      "id": "moderation",
      "point": "gateway.request",
      "order": 200,
      "match": {
        "protocols": [
          "anthropic.messages",
          "openai.chat",
          "openai.responses",
          "openai.responses_ws",
          "gemini.generate",
          "gemini.stream_generate",
          "volcengine.images",
          "volcengine.video_submit"
        ]
      },
      "needs": [
        "model",
        "system|@this",
        "messages|@this",
        "tools|@this",
        "input|@this",
        "instructions|@this",
        "contents|@this",
        "systemInstruction|@this",
        "system_instruction|@this",
        "prompt|@this",
        "content|@this",
        "image|@this"
      ],
      "timeoutMs": 30000,
      "failure": "open"
    },
    {
      "id": "moderation_attempt",
      "point": "gateway.attempt",
      "order": 200,
      "match": {
        "protocols": [
          "anthropic.messages",
          "openai.chat",
          "openai.responses",
          "openai.responses_ws",
          "gemini.generate",
          "gemini.stream_generate",
          "volcengine.images",
          "volcengine.video_submit"
        ]
      },
      "needs": [
        "model",
        "system|@this",
        "messages|@this",
        "tools|@this",
        "input|@this",
        "instructions|@this",
        "contents|@this",
        "systemInstruction|@this",
        "system_instruction|@this",
        "prompt|@this",
        "content|@this",
        "image|@this"
      ],
      "timeoutMs": 30000,
      "failure": "open"
    }
  ],
  "jobs": [
    {
      "id": "cleanup",
      "schedule": "0 4 * * *",
      "timeoutSec": 600
    },
    {
      "id": "alerts",
      "schedule": "@every 1m",
      "timeoutSec": 50
    }
  ],
  "database": {
    "schema": "plg_moderation",
    "migrations": "migrations/"
  },
  "userPermissions": [
    {
      "key": "moderation:read",
      "defaultRoles": ["admin"],
      "label": {
        "en": "View prompt moderation",
        "zh": "查看提示词审核"
      },
      "description": {
        "en": "All moderation pages, including the moderated text",
        "zh": "查看提示词审核的全部页面，包括被审核的原文"
      }
    },
    {
      "key": "moderation:manage",
      "defaultRoles": ["admin"],
      "label": {
        "en": "Manage prompt moderation",
        "zh": "管理提示词审核"
      },
      "description": {
        "en": "Change channels, auditors, flows, the watch list and bans; review records; run tests (paid upstream calls)",
        "zh": "修改渠道、审核器、流程、观察名单和封禁，处理记录，运行测试（会产生上游费用）"
      }
    },
    {
      "key": "moderation:exempt",
      "defaultRoles": [],
      "inheritFrom": ["moderation:read"],
      "label": {
        "en": "Exempt from moderation watch and bans",
        "zh": "免于审核观察与封禁"
      },
      "description": {
        "en": "Requests are still moderated and recorded, but the user never enters the watch list, is never banned and is left out of the user statistics",
        "zh": "请求照常审核并记录，但不会进入观察名单、不会被封禁，也不计入用户统计"
      }
    }
  ],
