{
  "apiVersion": 1,
  "key": "moderation",
  "name": {
    "en": "Prompt Moderation",
    "zh": "提示词审核"
  },
  "description": {
    "en": "Moderates gateway requests with flows of auditors (OpenAI moderation, TypeSafe Jev, LLM verdict) bound to groups. Users on the watch list at the enforce level are moderated before the upstream call and refused on a hit; the others are moderated in the background. Suspicious users join the watch list automatically; an AI analysis reviews their records and can adjust the watch level; repeated violations can ban them. The cost of every moderation call is shown with the core model prices.",
    "zh": "按分组绑定的审核流程（OpenAI 内容审核、TypeSafe Jev、大模型判定）审核网关请求。观察名单中拦截级的用户先审后发、命中即拒绝，其余请求在后台审核。可疑用户自动进入观察名单，AI 分析复核其记录并可调整名单级别，多次违规可自动封禁。每次审核调用的费用按核心的模型价格展示。"
  },
  "version": "0.6.2",
  "publisher": "sub2api",
  "icon": "text:M",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.224 <0.2.0",
  "hostUICompat": "^3.3",
  "capabilities": [
    {
      "id": "gateway.hook.v1"
    },
    {
      "id": "app.jobs.v1"
    },
    {
      "id": "app.broadcast.v1"
    },
    {
      "id": "http.routes.v1"
    }
  ],
  "hooks": [
    {
      "id": "ban",
      "point": "gateway.request",
      "order": 199,
      "timeoutMs": 2000,
      "failure": "open"
    },
    {
      "id": "moderation",
      "point": "gateway.request",
      "order": 200,
      "match": {
        "protocols": [
          "anthropic.messages",
          "openai.chat",
          "openai.responses",
          "openai.responses_ws",
          "gemini.generate",
          "gemini.stream_generate",
          "volcengine.images",
          "volcengine.video_submit"
        ]
      },
      "needs": [
        "model",
        "system|@this",
        "messages|@this",
        "tools|@this",
        "input|@this",
        "instructions|@this",
        "contents|@this",
        "systemInstruction|@this",
        "system_instruction|@this",
        "prompt|@this",
        "content|@this",
        "image|@this"
      ],
      "timeoutMs": 30000,
      "failure": "open"
    }
  ],
  "jobs": [
    {
      "id": "cleanup",
      "schedule": "0 4 * * *",
      "timeoutSec": 600
    },
    {
      "id": "analysis",
      "schedule": "@every 1m",
      "timeoutSec": 60
    },
    {
      "id": "alerts",
      "schedule": "@every 1m",
      "timeoutSec": 50
    }
  ],
  "database": {
    "schema": "plg_moderation",
    "migrations": "migrations/"
  },
  "userPermissions": [
    {
      "key": "moderation:read",
      "label": {
        "en": "View prompt moderation",
        "zh": "查看提示词审核"
      },
      "description": {
        "en": "All moderation pages, including the moderated text",
        "zh": "查看提示词审核的全部页面，包括被审核的原文"
      }
    },
    {
      "key": "moderation:manage",
      "label": {
        "en": "Manage prompt moderation",
        "zh": "管理提示词审核"
      },
      "description": {
        "en": "Change channels, auditors, flows, the watch list and bans; review records; run tests (paid upstream calls)",
        "zh": "修改渠道、审核器、流程、观察名单和封禁，处理记录，运行测试（会产生上游费用）"
      }
    }
  ],
