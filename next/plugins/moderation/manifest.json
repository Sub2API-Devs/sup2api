  "hostPermissions": [
    {
      "id": "kv",
      "reason": {
        "en": "Share the verdict cache between nodes",
        "zh": "在节点之间共享审核判定缓存"
      }
    },
    {
      "id": "db.schema",
      "reason": {
        "en": "Store channels, auditors, flows, the watch list, records and bans",
        "zh": "保存渠道、审核器、流程、观察名单、审核记录和封禁"
      }
    },
    {
      "id": "secrets",
      "reason": {
        "en": "Encrypt the API keys of the moderation channels with the host key",
        "zh": "用宿主密钥加密审核渠道的 API Key"
      }
    },
    {
      "id": "prices",
      "reason": {
        "en": "Price the moderation calls with the core model prices (read only)",
        "zh": "按核心的模型价格计算审核调用的费用（只读）"
      }
    },
    {
      "id": "gateway.hook",
      "scope": {
        "points": [
          "gateway.request",
          "gateway.attempt"
        ],
        "fields": [
          "model",
          "system|@this",
          "messages|@this",
          "tools|@this",
          "input|@this",
          "instructions|@this",
          "contents|@this",
          "systemInstruction|@this",
          "system_instruction|@this",
          "prompt|@this",
          "content|@this",
          "image|@this"
        ]
      },
      "reason": {
        "en": "Read the model and the client-controlled content of gateway requests (messages of every role, system prompt or instructions, tool calls, results and definitions, documents, images, image and video prompts) to moderate it (before scheduling, or once the account is chosen when the flow is bound to accounts), refuse violating requests, and refuse banned users on every protocol",
        "zh": "读取网关请求的模型和客户端可控的全部内容（各角色的消息、系统提示词或 instructions、工具调用、结果与定义、文档、图片、生图和视频提示词）进行审核（调度前审核；流程绑定到账号时在选定账号后、发往该账号前审核），拒绝违规请求，并在所有协议上拒绝被封禁的用户"
      }
    },
    {
      "id": "users.read",
      "reason": {
        "en": "Check that a user exists before putting it on the watch list or banning it, and show user names and emails in the moderation pages (without it, any user id is accepted and pages show ids or the names the viewer may read)",
        "zh": "加入观察名单或封禁前确认用户存在，并在审核页面显示用户名和邮箱（不授予时不校验用户 id，页面显示 id 或查看者自己有权读取的用户名）"
      },
      "optional": true
    },
    {
      "id": "jobs",
      "reason": {
        "en": "Delete expired records, watch entries, bans and statistics daily; check flow error rates every minute",
        "zh": "每天清理过期的审核记录、观察名单、封禁和统计；每分钟检查流程异常率"
      }
    },
    {
      "id": "broadcast",
      "reason": {
        "en": "Tell the other nodes to reload the configuration, watch list and bans at once after a change",
        "zh": "配置、观察名单或封禁变化后通知其他节点立即重新加载"
      }
    },
    {
      "id": "routes.admin",
      "reason": {
        "en": "Moderation management APIs",
        "zh": "提示词审核管理接口"
      }
    },
    {
      "id": "ui.menu",
      "reason": {
        "en": "Add the \"Prompt Moderation\" menu",
        "zh": "添加\"提示词审核\"菜单"
      }
    },
    {
      "id": "ui.native",
      "reason": {
        "en": "Provide the moderation dashboard page",
        "zh": "提供提示词审核管理页面"
      }
    },
    {
      "id": "net",
      "scope": {
        "domains": [
          "*"
        ]
      },
      "optional": true,
      "reason": {
        "en": "Call the moderation channels and post notifications to the configured webhook (enforced when the egress policy is an allowlist)",
        "zh": "调用配置的审核渠道，并向配置的 webhook 发送通知（出口策略为白名单时生效）"
      }
    }
  ]
}
