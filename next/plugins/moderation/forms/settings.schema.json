{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Prompt moderation settings",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "title": "Mode",
      "enum": [
        "off",
        "observe",
        "enforce"
      ],
      "default": "off"
    },
    "exempt_user_ids": {
      "type": "array",
      "title": "Exempt user IDs",
      "default": [],
      "maxItems": 1000,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    },
    "block_status": {
      "type": "integer",
      "title": "Block status",
      "minimum": 400,
      "maximum": 599,
      "default": 403
    },
    "block_message": {
      "type": "string",
      "title": "Block message",
      "default": "提示词审核未通过，请调整输入后重试",
      "maxLength": 500
    },
    "auto_watch": {
      "type": "boolean",
      "title": "Auto watch",
      "default": true
    },
    "watch_days": {
      "type": "integer",
      "title": "Watch days",
      "minimum": 1,
      "maximum": 365,
      "default": 30
    },
    "analysis_every_violations": {
      "type": "integer",
      "title": "Analysis every N violations",
      "minimum": 0,
      "maximum": 1000,
      "default": 30
    },
    "ban_threshold": {
      "type": "integer",
      "title": "Ban threshold",
      "minimum": 0,
      "maximum": 1000,
      "default": 0
    },
    "ban_window_hours": {
      "type": "integer",
      "title": "Ban window (hours)",
      "minimum": 1,
      "maximum": 8760,
      "default": 24
    },
    "ban_duration_hours": {
      "type": "integer",
      "title": "Ban duration (hours)",
      "minimum": 0,
      "maximum": 87600,
      "default": 24
    },
    "analysis_channel_id": {
      "type": "integer",
      "title": "Analysis channel",
      "minimum": 0,
      "maximum": 2147483647,
      "default": 0
    },
    "analysis_guidelines": {
      "type": "string",
      "title": "Analysis guidelines",
      "default": "",
      "maxLength": 16384
    },
    "analysis_timeout_ms": {
      "type": "integer",
      "title": "Analysis timeout (ms)",
      "minimum": 10000,
      "maximum": 600000,
      "default": 60000
    },
    "analysis_concurrency": {
      "type": "integer",
      "title": "Analysis concurrency",
      "minimum": 1,
      "maximum": 16,
      "default": 2
    },
    "analysis_context_kb": {
      "type": "integer",
      "title": "Analysis context (KB)",
      "minimum": 16,
      "maximum": 1024,
      "default": 64
    },
    "analysis_keep_per_user": {
      "type": "integer",
      "title": "Analyses kept per user",
      "minimum": 1,
      "maximum": 1000,
      "default": 20
    },
    "analysis_allow_upgrade": {
      "type": "boolean",
      "title": "Allow AI upgrade",
      "default": true
    },
    "analysis_allow_downgrade": {
      "type": "boolean",
      "title": "Allow AI downgrade",
      "default": true
    },
    "analysis_allow_remove": {
      "type": "boolean",
      "title": "Allow AI removal",
      "default": true
    },
    "record_pass": {
      "type": "boolean",
      "title": "Record passed checks",
      "default": false
    },
    "record_overturned": {
      "type": "boolean",
      "title": "Record overturned",
      "default": true
    },
    "record_errors": {
      "type": "boolean",
      "title": "Record errors",
      "default": true
    },
    "store_text": {
      "type": "boolean",
      "title": "Store moderated text",
      "default": true
    },
    "hit_retention_days": {
      "type": "integer",
      "title": "Hit retention (days)",
      "minimum": 1,
      "maximum": 3650,
      "default": 180
    },
    "overturned_retention_days": {
      "type": "integer",
      "title": "Overturned retention (days)",
      "minimum": 1,
      "maximum": 3650,
      "default": 30
    },
    "error_retention_days": {
      "type": "integer",
      "title": "Error retention (days)",
      "minimum": 1,
      "maximum": 3650,
      "default": 7
    },
    "pass_retention_days": {
      "type": "integer",
      "title": "Pass retention (days)",
      "minimum": 1,
      "maximum": 3,
      "default": 3
    },
    "max_concurrency": {
      "type": "integer",
      "title": "Max concurrency",
      "minimum": 1,
      "maximum": 256,
      "default": 16
    },
    "queue_size": {
      "type": "integer",
      "title": "Queue size",
      "minimum": 1,
      "maximum": 100000,
      "default": 1000
    },
    "cache_ttl_seconds": {
      "type": "integer",
      "title": "Cache TTL (s)",
      "minimum": 0,
      "maximum": 604800,
      "default": 3600
    },
    "cache_entries": {
      "type": "integer",
      "title": "Cache entries",
      "minimum": 1000,
      "maximum": 1000000,
      "default": 100000
    },
    "input_max_chars": {
      "type": "integer",
      "title": "Max input characters",
      "minimum": 256,
      "maximum": 100000,
      "default": 12000
    },
    "min_chars": {
      "type": "integer",
      "title": "Min characters",
      "minimum": 0,
      "maximum": 1000,
      "default": 2
    },
    "jev_default_set": {
      "title": "Jev default question set",
      "default": null,
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "preamble": {
              "type": "string",
              "maxLength": 2000
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "required": [
                  "category",
                  "question",
                  "threshold"
                ],
                "properties": {
                  "category": {
                    "type": "string",
                    "pattern": "^[a-z0-9/_-]{1,64}$"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "answer_yes": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "answer_no": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "threshold": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "default": "",
      "maxLength": 500,
      "pattern": "^(https?://\\S+)?$",
      "readOnly": true
    },
    "api_key": {
      "type": "string",
      "title": "API key",
      "default": "",
      "maxLength": 1000,
      "writeOnly": true,
      "readOnly": true
    },
    "model": {
      "type": "string",
      "title": "Model",
      "default": "",
      "maxLength": 200,
      "readOnly": true
    },
    "system_prompt": {
      "type": "string",
      "title": "System prompt",
      "default": "",
      "maxLength": 20000,
      "readOnly": true
    },
    "categories": {
      "type": "array",
      "title": "Categories",
      "default": [],
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "title": "ID",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "",
            "maxLength": 500
          }
        }
      },
      "readOnly": true
    },
    "tool_choice": {
      "type": "string",
      "title": "Tool choice",
      "enum": [
        "required",
        "function",
        "auto"
      ],
      "default": "required",
      "readOnly": true
    },
    "max_turns": {
      "type": "integer",
      "title": "Max turns",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "readOnly": true
    },
    "temperature": {
      "type": "number",
      "title": "Temperature",
      "minimum": 0,
      "maximum": 2,
      "default": 0,
      "readOnly": true
    },
    "max_tokens": {
      "type": "integer",
      "title": "Max tokens",
      "minimum": 64,
      "maximum": 4096,
      "default": 512,
      "readOnly": true
    },
    "timeout_ms": {
      "type": "integer",
      "title": "Timeout (ms)",
      "minimum": 1000,
      "maximum": 25000,
      "default": 10000,
      "readOnly": true
    },
    "on_error": {
      "type": "string",
      "title": "On error",
      "enum": [
        "allow",
        "block"
      ],
      "default": "allow",
      "readOnly": true
    },
    "sample_rate": {
      "type": "integer",
      "title": "Sample rate (%)",
      "minimum": 1,
      "maximum": 100,
      "default": 100,
      "readOnly": true
    },
    "group_ids": {
      "type": "array",
      "title": "Groups",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "readOnly": true
    },
    "model_patterns": {
      "type": "array",
      "title": "Model patterns",
      "default": [],
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "readOnly": true
    },
    "retention_days": {
      "type": "integer",
      "title": "Retention (days)",
      "minimum": 1,
      "maximum": 3650,
      "default": 30,
      "readOnly": true
    }
  }
}
