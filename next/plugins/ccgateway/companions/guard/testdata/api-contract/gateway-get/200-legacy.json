{
  "name": "200 legacy",
  "covers": "D4",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-xray:1",
        "labels": {
          "io.sup2api.ccgateway.shared-egress": "1"
        }
      }
    ],
    "networks": [
      {
        "aid": "d0000000000000000",
        "role": "xray-uplink",
        "subnet": "10.117.81.0/24"
      }
    ],
    "gateway": {
      "managed_by": "legacy",
      "networks": {
        "21": "10.52.74.2"
      }
    }
  },
  "request": {
    "method": "GET",
    "path": "/v1/gateway"
  },
  "response": {
