{
  "name": "202",
  "covers": "R14 X5",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-controller:2",
        "labels": {
          "io.sup2api.ccgateway.guard-api": "1",
          "io.sup2api.ccgateway.shared-egress": "1"
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/v1/controller/upgrade",
    "json": {
      "image": "ccgateway-controller:2"
    }
  },
  "response": {
    "status": 202,
    "body": {
      "accepted": true
    },
    "keys": [
      "accepted"
    ]
  }
}
