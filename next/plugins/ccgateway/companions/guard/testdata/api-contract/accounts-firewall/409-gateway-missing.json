{
  "name": "409 gateway missing",
  "covers": "R12",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-app:1"
      }
    ],
    "networks": [
      {
        "aid": "21",
        "subnet": "10.52.74.0/24"
      }
    ],
    "volumes": [
      {
        "aid": "21",
        "quota": true
      }
    ],
    "containers": [
      {
        "aid": "21",
        "status": "running",
        "ipv4": "10.52.74.5"
      }
    ],
    "files": {
      "21/resolv.conf": "ok"
    }
  },
  "request": {
    "method": "PUT",
    "path": "/v1/accounts/21/firewall",
    "json": {
      "default_gateway": "10.52.74.2",
      "rules": "table inet ccg_app {}\n"
    }
  },
  "response": {
    "status": 409,
    "body": {
      "error": "conflict",
      "names": [
        "ccg-shared-egress"
      ],
      "reason": "not_running"
    }
  },
  "after": {
    "docker_unchanged": true
  }
}
