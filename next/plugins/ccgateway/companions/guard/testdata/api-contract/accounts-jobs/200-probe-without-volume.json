{
  "name": "200 probe without volume",
  "covers": "R8",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-app:1"
      }
    ],
    "job": {
      "exit_code": 0,
      "stdout": "ok"
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/accounts/21/jobs",
    "json": {
      "argv": [
        "true"
      ],
      "entrypoint": [
        "sh",
        "-ec"
      ],
      "image": "ccgateway-app:1",
      "memory_bytes": 2147483648,
      "user": "0",
      "volume": "none"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "exit_code": 0,
      "stdout": "b2s="
    },
    "keys": [
      "exit_code",
      "stdout"
    ]
  }
}
