{
  "name": "504 job_timeout",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-app:1"
      }
    ],
    "networks": [
      {
        "aid": "21",
        "subnet": "10.52.74.0/24"
      }
    ],
    "volumes": [
      {
        "aid": "21",
        "quota": true
      }
    ],
    "files": {
      "21/resolv.conf": "ok"
    },
    "job": {
      "exit_code": 0,
      "hang": true
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/accounts/21/jobs",
    "json": {
      "argv": [
        "true"
      ],
      "caps": [
        "CHOWN",
        "DAC_OVERRIDE"
      ],
      "entrypoint": [
        "sh",
        "-ec"
      ],
      "image": "ccgateway-app:1",
      "user": "0",
      "volume": "rw"
    }
  },
  "response": {
    "status": 504,
    "body": {
      "error": "timeout",
      "reason": "job_timeout"
    }
  }
}
