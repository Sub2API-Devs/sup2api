{
  "name": "200 merged output",
  "covers": "R5",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-app:1"
      }
    ],
    "networks": [
      {
        "aid": "21",
        "subnet": "10.52.74.0/24"
      }
    ],
    "volumes": [
      {
        "aid": "21",
        "quota": true
      }
    ],
    "containers": [
      {
        "aid": "21",
        "status": "running",
        "ipv4": "10.52.74.5"
      }
    ],
    "files": {
      "21/resolv.conf": "ok"
    },
    "exec": {
      "stdout": "out\n",
      "stderr": "err\n",
      "exit_code": 3
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/accounts/21/app/exec",
    "json": {
      "argv": [
        "sh",
        "-c",
        "x"
      ],
      "user": "0"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "exit_code": 3,
      "output": "b3V0CmVycgo="
    },
    "keys": [
      "exit_code",
      "output"
    ]
  }
}
