{
  "name": "404 gateway",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-app:1"
      }
    ],
    "networks": [
      {
        "aid": "21",
        "subnet": "10.52.74.0/24"
      }
    ],
    "volumes": [
      {
        "aid": "21",
        "quota": true
      }
    ],
    "containers": [
      {
        "aid": "21",
        "status": "running",
        "ipv4": "10.52.74.5"
      }
    ],
    "files": {
      "21/resolv.conf": "ok"
    }
  },
  "request": {
    "method": "PUT",
    "path": "/v1/gateway/networks/21",
    "json": {
      "ipv4": "10.52.74.2"
    }
  },
  "response": {
    "status": 404,
    "body": {
      "error": "not_found",
      "reason": "gateway"
    }
  },
  "after": {
    "docker_unchanged": true
  }
}
