{
  "name": "403 resolv.conf replaced by a link",
  "covers": "A3",
  "setup": {
    "images": [
      {
        "ref": "ccgateway-app:1"
      }
    ],
    "networks": [
      {
        "aid": "21",
        "subnet": "10.52.74.0/24"
      }
    ],
    "volumes": [
      {
        "aid": "21",
        "quota": true
      }
    ],
    "containers": [
      {
        "aid": "21",
        "status": "created",
        "ipv4": "10.52.74.5"
      }
    ],
    "files": {
      "21/resolv.conf": "symlink"
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/accounts/21/app/restart",
    "json": {}
  },
  "response": {
    "status": 403,
    "body": {
      "error": "forbidden",
      "reason": "mount_source_rejected"
    }
  },
  "after": {
    "docker_unchanged": true
  }
}
