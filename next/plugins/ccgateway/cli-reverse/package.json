{
  "name": "cc-2.1.318-reconstructed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AST-based reconstruction of the official Claude Code CLI 2.1.318 into a readable project",
  "scripts": {
    "build": "node reconstructed/build.mjs",
    "verify": "node tools/verify/compare.mjs original original",
    "verify:runnable": "node tools/verify/compare.mjs original runnable",
    "verify:scenarios": "node tools/verify/scenarios.mjs original",
    "verify:run": "node tools/verify/run.mjs",
    "verify:upstream": "node tools/verify/fake-upstream.mjs",
    "verify:readable": "node tools/verify/compare.mjs original reconstructed/dist --name original-vs-reconstructed-dist",
    "verify:decl": "node --max-old-space-size=12000 tools/verify/decl-equiv.mjs"
  },
  "devDependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "bun": "1.4.4",
    "eslint-scope": "8.4.0",
    "espree": "10.4.0",
    "prettier": "^3.9.10"
  }
}
