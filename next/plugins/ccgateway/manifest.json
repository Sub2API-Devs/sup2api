        "claude-3-7-sonnet-latest",
        "claude-3-7-sonnet-20250219",
        "claude-3-5-sonnet-latest",
        "claude-3-5-sonnet-20241022",
        "claude-3-5-sonnet-20240620",
        "claude-3-5-haiku-latest",
        "claude-3-5-haiku-20241022",
        "claude-3-haiku-20240307"
      ],
      "defaultModelMapping": {
        "claude-opus-4-1": "claude-opus-4-5",
        "claude-opus-4-1-20250805": "claude-opus-4-5-20251101",
        "claude-3-opus-20240229": "claude-opus-4-5-20251101",
        "claude-3-7-sonnet-latest": "claude-sonnet-4-5",
        "claude-3-7-sonnet-20250219": "claude-sonnet-4-5-20250929",
        "claude-3-5-sonnet-latest": "claude-sonnet-4-5",
        "claude-3-5-sonnet-20241022": "claude-sonnet-4-5-20250929",
        "claude-3-5-sonnet-20240620": "claude-sonnet-4-5-20250929",
        "claude-3-5-haiku-latest": "claude-haiku-4-5",
        "claude-3-5-haiku-20241022": "claude-haiku-4-5-20251001",
        "claude-3-haiku-20240307": "claude-haiku-4-5-20251001"
      },
      "platforms": [
        {
          "platform": "anthropic",
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-ccgateway-session-id"
          ]
        }
      ],
      "sensitiveFields": [
        "api_key"
      ],
      "creationGroup": "claude-code",
      "authMethodLabel": {
        "en": "API Key",
        "zh": "API Key"
      }
    }
  ],
  "resources": {
    "memoryMB": 32,
    "cpu": 0.1,
    "maxThreads": 32,
    "maxOpenFiles": 64
  },
  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register managed Claude Code accounts for Anthropic Messages",
        "zh": "为 Anthropic Messages 注册托管 Claude Code 账号"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Validate OAuth and API key account credentials.",
        "zh": "校验 OAuth 与 API Key 账号凭证。"
      }
    }
  ]
}
