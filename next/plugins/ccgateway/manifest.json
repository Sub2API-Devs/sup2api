{
  "apiVersion": 1,
  "key": "ccgateway",
  "name": {
    "en": "CCGateway",
    "zh": "CCGateway"
  },
  "description": {
    "en": "Managed Claude Code Messages accounts. SSH connections and credentials are managed by the core. Token counting and model discovery are not supported.",
    "zh": "托管 Claude Code Messages 账号，SSH 连接与凭证由核心管理；支持流式响应及用量计费，不支持 token 预估与模型发现。"
  },
  "version": "0.1.3",
  "publisher": "sub2api",
  "icon": "text:C",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.18 <0.2.0",
  "capabilities": [
    {
      "id": "platform.adapter.v1"
    }
  ],
  "accountTypes": [
    {
      "id": "managed",
      "label": {
        "en": "Claude Code (OAuth)",
        "zh": "Claude Code（OAuth）"
      },
      "description": {
        "en": "Authorize Claude Code with OAuth in an isolated account container.",
        "zh": "在账号独立容器中使用 OAuth 授权 Claude Code。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/managed.schema.json",
        "uiSchema": "forms/managed.ui.json"
      },
      "platforms": [
        {
          "platform": "anthropic",
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-ccgateway-session-id"
          ]
        }
      ]
    },
    {
      "id": "apikey",
      "label": {
        "en": "Claude Code (API Key)",
        "zh": "Claude Code（API Key）"
      },
      "description": {
        "en": "Use an API key and Anthropic-compatible base URL in the same isolated runtime.",
        "zh": "使用 API Key 和 Anthropic 兼容地址，共用独立容器与账号代理。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "platforms": [
        {
          "platform": "anthropic",
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-ccgateway-session-id"
          ]
        }
      ],
      "sensitiveFields": [
        "api_key"
      ]
    }
  ],
  "resources": {
    "memoryMB": 32,
    "cpu": 0.1,
    "maxThreads": 32,
    "maxOpenFiles": 64
  },
  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register managed Claude Code accounts for Anthropic Messages",
        "zh": "为 Anthropic Messages 注册托管 Claude Code 账号"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Validate OAuth and API key account credentials.",
        "zh": "校验 OAuth 与 API Key 账号凭证。"
      }
    }
  ]
}
