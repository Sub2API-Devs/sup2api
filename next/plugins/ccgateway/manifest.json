{
  "apiVersion": 1,
  "key": "ccgateway",
  "name": {
    "en": "CCGateway",
    "zh": "CCGateway"
  },
  "description": {
    "en": "Managed Claude Code Messages accounts. SSH connections and credentials are managed by the core. Token counting uses the account's upstream count endpoint; provider support is required. Model discovery is not supported.",
    "zh": "托管 Claude Code Messages 账号，SSH 连接与凭证由核心管理；支持流式响应及用量计费，token 计数调用账号上游计数接口，需上游支持；不支持模型发现。"
  },
  "version": "0.1.10",
  "publisher": "sub2api",
  "icon": "assets/claudecode-color.svg",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.18 <0.2.0",
  "capabilities": [
    {
      "id": "platform.adapter.v1"
    }
  ],
  "accountTypes": [
    {
      "id": "managed",
      "label": {
        "en": "Claude Code",
        "zh": "Claude Code"
      },
      "description": {
        "en": "One isolated container per account. Choose OAuth authorization code or API Key when configuring the account.",
        "zh": "每个账号使用独立容器，进入后选择 OAuth 授权码或 API Key 鉴权。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/managed.schema.json",
        "uiSchema": "forms/managed.ui.json"
      },
      "defaultModels": ["claude-fable-5", "claude-opus-5", "claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6", "claude-sonnet-5", "claude-sonnet-4-6", "claude-haiku-4-5-20251001", "claude-fable-5-1", "claude-opus-5-5"],
      "platforms": [
        {
          "platform": "anthropic",
          "endpoints": ["messages", "count_tokens"],
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-ccgateway-session-id"
          ]
        }
      ],
      "creationGroup": "claude-code",
      "authMethodLabel": {
        "en": "OAuth authorization code",
        "zh": "OAuth 授权码"
      }
    },
    {
      "id": "apikey",
      "label": {
        "en": "Claude Code",
        "zh": "Claude Code"
      },
      "description": {
        "en": "One isolated container per account. Choose OAuth authorization code or API Key when configuring the account.",
        "zh": "每个账号使用独立容器，进入后选择 OAuth 授权码或 API Key 鉴权。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "defaultModels": ["claude-fable-5", "claude-opus-5", "claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6", "claude-sonnet-5", "claude-sonnet-4-6", "claude-haiku-4-5-20251001", "claude-fable-5-1", "claude-opus-5-5"],
      "platforms": [
        {
          "platform": "anthropic",
          "endpoints": ["messages", "count_tokens"],
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-ccgateway-session-id"
          ]
        }
      ],
      "sensitiveFields": [
        "api_key"
      ],
      "creationGroup": "claude-code",
      "authMethodLabel": {
        "en": "API Key",
        "zh": "API Key"
      }
    }
  ],
  "resources": {
    "memoryMB": 32,
    "cpu": 0.1,
    "maxThreads": 32,
    "maxOpenFiles": 64
  },
  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register managed Claude Code accounts for Anthropic Messages",
        "zh": "为 Anthropic Messages 注册托管 Claude Code 账号"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Validate OAuth and API key account credentials.",
        "zh": "校验 OAuth 与 API Key 账号凭证。"
      }
    }
  ]
}
