{
  "apiVersion": 1,
  "key": "ccgateway",
  "name": {
    "en": "CCGateway",
    "zh": "CCGateway"
  },
  "description": {
    "en": "Managed Claude Code Messages accounts. SSH connections and credentials are managed by the core. Token counting and model discovery are not supported.",
    "zh": "托管 Claude Code Messages 账号，SSH 连接与凭证由核心管理；支持流式响应及用量计费；不支持 token 计数和模型发现。"
  },
  "version": "0.1.95",
  "publisher": "sub2api",
  "icon": "assets/claudecode-color.svg",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.172 <0.2.0",
  "capabilities": [
    {
      "id": "platform.adapter.v1"
    },
    {
      "id": "account.lifecycle.v1"
    }
  ],
  "accountTypes": [
    {
      "id": "managed",
      "modelAvailability": true,
      "quota": {
        "query": true,
        "autoRefresh": true,
        "windows": [
          {"key": "5h", "label": {"en": "5-hour usage", "zh": "5 小时用量"}, "shortLabel": {"en": "5h", "zh": "5 小时"}},
          {"key": "7d", "label": {"en": "Shared weekly usage", "zh": "共享周用量"}, "shortLabel": {"en": "7d", "zh": "7 天"}},
          {"key": "7d_fable", "label": {"en": "Fable weekly usage", "zh": "Fable 周用量"}, "shortLabel": {"en": "Fable 7d", "zh": "Fable 7 天"}},
          {"key": "7d_sonnet", "label": {"en": "Sonnet weekly usage", "zh": "Sonnet 周用量"}, "shortLabel": {"en": "Sonnet 7d", "zh": "Sonnet 7 天"}}
        ]
      },
      "lifecycle": {"preparation": true, "required": true, "actions": [{"id": "refresh_token", "label": {"en": "Refresh token", "zh": "刷新令牌"}, "icon": "refresh"}, {"id": "refresh_auth", "label": {"en": "Refresh authorization", "zh": "重新授权"}, "icon": "refresh"}], "deletion": {"retentionDays": 3}},
      "label": {
        "en": "Claude Code",
        "zh": "Claude Code"
      },
      "description": {
        "en": "One isolated container per account. Choose OAuth authorization code or API Key when configuring the account.",
        "zh": "每个账号使用独立容器，进入后选择 OAuth 授权码或 API Key 鉴权。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/managed.schema.json",
        "uiSchema": "forms/managed.ui.json"
      },
      "extensionsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locale": {"type": "string", "maxLength": 32},
          "timezone": {"type": "string", "maxLength": 128},
          "account_email": {"type": "string", "maxLength": 320, "readOnly": true, "x-label": {"en": "Login email", "zh": "登录邮箱"}}
        }
      },
      "commonControls": {
        "auto_disable": {"configurable": true, "default": true},
        "schedulable": {"configurable": true, "default": true}
      },
      "defaultModels": ["claude-fable-5", "claude-opus-5", "claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6", "claude-sonnet-5", "claude-sonnet-4-6", "claude-haiku-4-5-20251001", "claude-fable-5-1", "claude-opus-5-5", "claude-sonnet-5-5"],
      "defaultModelsBySubscription": {
        "pro": ["claude-opus-5", "claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6", "claude-sonnet-5", "claude-sonnet-4-6", "claude-haiku-4-5-20251001", "claude-opus-5-5", "claude-sonnet-5-5"]
      },
      "platforms": [
        {
          "platform": "anthropic",
          "endpoints": ["messages"],
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-claude-code-request-class",
            "x-claude-code-agent-id",
            "x-claude-code-parent-agent-id",
            "x-claude-code-agent-type",
            "x-claude-code-prompt-id",
            "x-claude-code-prev-tool-durations",
            "x-cc-compaction-request",
            "x-claude-code-compaction",
            "x-cc-context-compacted",
            "x-claude-code-context-compacted",
            "user-agent"
          ]
        }
      ],
      "creationGroup": "claude-code",
      "authMethodLabel": {
        "en": "OAuth authorization code",
        "zh": "OAuth 授权码"
      }
    },
    {
      "id": "apikey",
      "lifecycle": {"deletion": {"retentionDays": 3}},
      "label": {
        "en": "Claude Code",
        "zh": "Claude Code"
      },
      "description": {
        "en": "One isolated container per account. Choose OAuth authorization code or API Key when configuring the account.",
        "zh": "每个账号使用独立容器，进入后选择 OAuth 授权码或 API Key 鉴权。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "extensionsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locale": {"type": "string", "maxLength": 32},
          "timezone": {"type": "string", "maxLength": 128}
        }
      },
      "commonControls": {
        "auto_disable": {"configurable": true, "default": true},
        "schedulable": {"configurable": true, "default": true}
      },
      "defaultModels": ["claude-fable-5", "claude-opus-5", "claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6", "claude-sonnet-5", "claude-sonnet-4-6", "claude-haiku-4-5-20251001", "claude-fable-5-1", "claude-opus-5-5", "claude-sonnet-5-5"],
      "platforms": [
        {
          "platform": "anthropic",
          "endpoints": ["messages"],
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-claude-code-request-class",
            "x-claude-code-agent-id",
            "x-claude-code-parent-agent-id",
            "x-claude-code-agent-type",
            "x-claude-code-prompt-id",
            "x-claude-code-prev-tool-durations",
            "x-cc-compaction-request",
            "x-claude-code-compaction",
            "x-cc-context-compacted",
            "x-claude-code-context-compacted",
            "user-agent"
          ]
        }
      ],
      "sensitiveFields": [
        "api_key"
      ],
      "creationGroup": "claude-code",
      "authMethodLabel": {
        "en": "API Key",
        "zh": "API Key"
      }
    }
  ],
  "resources": {
    "memoryMB": 32,
    "cpu": 0.1,
    "maxThreads": 32,
    "maxOpenFiles": 64
  },
  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register managed Claude Code accounts for Anthropic Messages",
        "zh": "为 Anthropic Messages 注册托管 Claude Code 账号"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Validate OAuth and API key account credentials.",
        "zh": "校验 OAuth 与 API Key 账号凭证。"
      }
    }
  ]
}
