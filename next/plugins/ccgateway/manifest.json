{
  "apiVersion": 1,
  "key": "ccgateway",
  "name": {
    "en": "CCGateway",
    "zh": "CCGateway"
  },
  "description": {
    "en": "Managed Claude Code Messages accounts. SSH connections and credentials are managed by the core. Token counting and model discovery are not supported.",
    "zh": "托管 Claude Code Messages 账号，SSH 连接与凭证由核心管理；支持流式响应及用量计费，不支持 token 预估与模型发现。"
  },
  "version": "0.1.5",
  "publisher": "sub2api",
  "icon": "assets/claudecode-color.svg",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.18 <0.2.0",
  "capabilities": [
    {
      "id": "platform.adapter.v1"
    }
  ],
  "accountTypes": [
    {
      "id": "managed",
      "label": {
        "en": "Claude Code",
        "zh": "Claude Code"
      },
      "description": {
        "en": "One isolated container per account. Choose OAuth authorization code or API Key when configuring the account.",
        "zh": "每个账号使用独立容器，进入后选择 OAuth 授权码或 API Key 鉴权。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/managed.schema.json",
        "uiSchema": "forms/managed.ui.json"
      },
      "defaultModels": [
        "claude-fable-5-1",
        "claude-fable-5",
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
        "claude-opus-4-6",
        "claude-opus-4-5",
        "claude-opus-4-5-20251101",
        "claude-sonnet-5-5",
        "claude-sonnet-5",
        "claude-sonnet-4-6",
        "claude-sonnet-4-5",
        "claude-sonnet-4-5-20250929",
        "claude-haiku-4-5",
        "claude-haiku-4-5-20251001",
        "claude-opus-4-20250514",
        "claude-sonnet-4-20250514",
        "claude-opus-4-1",
        "claude-opus-4-1-20250805",
        "claude-3-opus-20240229",
        "claude-3-7-sonnet-latest",
        "claude-3-7-sonnet-20250219",
        "claude-3-5-sonnet-latest",
        "claude-3-5-sonnet-20241022",
        "claude-3-5-sonnet-20240620",
        "claude-3-5-haiku-latest",
        "claude-3-5-haiku-20241022",
        "claude-3-haiku-20240307"
      ],
      "defaultModelMapping": {
        "claude-opus-4-1": "claude-opus-4-5",
        "claude-opus-4-1-20250805": "claude-opus-4-5-20251101",
        "claude-3-opus-20240229": "claude-opus-4-5-20251101",
        "claude-3-7-sonnet-latest": "claude-sonnet-4-5",
        "claude-3-7-sonnet-20250219": "claude-sonnet-4-5-20250929",
        "claude-3-5-sonnet-latest": "claude-sonnet-4-5",
        "claude-3-5-sonnet-20241022": "claude-sonnet-4-5-20250929",
        "claude-3-5-sonnet-20240620": "claude-sonnet-4-5-20250929",
        "claude-3-5-haiku-latest": "claude-haiku-4-5",
        "claude-3-5-haiku-20241022": "claude-haiku-4-5-20251001",
        "claude-3-haiku-20240307": "claude-haiku-4-5-20251001"
      },
      "platforms": [
        {
          "platform": "anthropic",
          "requestFields": [
            "model"
          ],
          "passHeaders": [
            "anthropic-version",
            "anthropic-beta",
            "x-ccgateway-session-id"
          ]
        }
      ],
      "creationGroup": "claude-code",
      "authMethodLabel": {
        "en": "OAuth authorization code",
        "zh": "OAuth 授权码"
      }
    },
    {
      "id": "apikey",
      "label": {
        "en": "Claude Code",
        "zh": "Claude Code"
      },
      "description": {
        "en": "One isolated container per account. Choose OAuth authorization code or API Key when configuring the account.",
        "zh": "每个账号使用独立容器，进入后选择 OAuth 授权码或 API Key 鉴权。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "defaultModels": [
        "claude-fable-5-1",
        "claude-fable-5",
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
