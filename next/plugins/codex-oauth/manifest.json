{
  "apiVersion": 1,
  "key": "codex_oauth",
  "name": {
    "en": "OpenAI Codex OAuth Accounts",
    "zh": "OpenAI Codex OAuth 账号"
  },
  "description": {
    "en": "OAuth authentication for OpenAI Codex accounts (responses endpoint)",
    "zh": "OpenAI Codex 账号的 OAuth 认证（responses 端点）"
  },
  "version": "0.1.0",
  "publisher": "sup2api",
  "icon": "text:OX",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    {
      "id": "platform.adapter.v1"
    },
    {
      "id": "app.jobs.v1"
    },
    {
      "id": "http.routes.v1"
    }
  ],

  "accountTypes": [
    {
      "id": "codex_oauth",
      "label": {
        "en": "OpenAI Codex OAuth",
        "zh": "OpenAI Codex OAuth"
      },
      "description": {
        "en": "Full OAuth authorization for Codex responses endpoint",
        "zh": "Codex responses 端点的完整 OAuth 授权"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/oauth.schema.json"
      },
      "sensitiveFields": [
        "access_token",
        "refresh_token",
        "id_token"
      ],
      "settingsFields": [
        "proxy_id",
        "organization_id"
      ],
      "platforms": [
        {
          "platform": "openai",
          "endpoints": ["responses"]
        }
      ],
      "defaultModels": [
        "gpt-4o-mini",
        "gpt-4o",
        "gpt-4-turbo"
      ]
    }
  ],

  "jobs": [
    {
      "id": "refresh_tokens",
      "schedule": "@every 30m",
      "timeoutSec": 300
    }
  ],

  "userPermissions": [
    {
      "key": "codex_oauth:manage",
      "label": {
        "en": "Manage OpenAI Codex OAuth accounts",
        "zh": "管理 OpenAI Codex OAuth 账号"
      },
      "description": {
        "en": "Create and manage OpenAI Codex OAuth accounts",
        "zh": "创建和管理 OpenAI Codex OAuth 账号"
      }
    }
  ],

  "routes": [
    {
      "method": "POST",
      "path": "/auth/start",
      "scope": "admin",
      "permission": "codex_oauth:manage"
    },
    {
      "method": "POST",
      "path": "/auth/exchange",
      "scope": "admin",
      "permission": "codex_oauth:manage"
    }
  ],

  "resources": {
    "memoryMB": 128,
    "cpu": 0.25,
    "maxThreads": 64,
    "maxOpenFiles": 256
  },

  "hostPermissions": [
    {
      "id": "kv",
      "reason": {
        "en": "Store OAuth session state and access token cache",
        "zh": "存储 OAuth 会话状态和访问令牌缓存"
      }
    },
    {
      "id": "accounts.credentials",
      "reason": {
        "en": "Read account credentials to check token expiration and refresh tokens",
        "zh": "读取账号凭证以检查令牌过期并刷新令牌"
      }
    },
    {
      "id": "jobs",
      "reason": {
        "en": "Periodically refresh expiring OAuth tokens",
        "zh": "定期刷新即将过期的 OAuth 令牌"
      }
    },
    {
      "id": "routes.admin",
      "reason": {
        "en": "OAuth authorization flow endpoints",
        "zh": "OAuth 授权流程端点"
      }
    },
    {
      "id": "net",
      "scope": {
        "domains": [
          "auth.openai.com",
          "api.openai.com"
        ]
      },
      "reason": {
        "en": "Call OpenAI OAuth endpoints to exchange codes and refresh tokens",
        "zh": "调用 OpenAI OAuth 端点交换代码和刷新令牌"
      }
    }
  ]
}
