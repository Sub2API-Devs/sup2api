{
  "apiVersion": 1,
  "key": "anthropic",
  "name": { "en": "Anthropic", "zh": "Anthropic" },
  "description": {
    "en": "Anthropic API key account type and a model catalog. The anthropic platform and its endpoints are built into the core; model prices are set by administrators in the core.",
    "zh": "Anthropic API Key 账号类型与模型目录（anthropic 平台及其端点由核心内置；模型价格由管理员在核心中配置）。"
  },
  "version": "0.3.1",
  "publisher": "sub2api",
  "icon": "assets/anthropic.svg",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.262 <0.2.0",

  "capabilities": [
    { "id": "platform.adapter.v1" },
    { "id": "http.routes.v1" }
  ],

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "Anthropic", "zh": "Anthropic" },
      "description": {
        "en": "An Anthropic Console API key, or a key for an Anthropic-compatible endpoint (set Base URL).",
        "zh": "Anthropic 控制台的 API Key，或 Anthropic 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url"],
      "guardedSettings": [
        { "field": "base_url", "allowed": ["https://api.anthropic.com"] }
      ],
      "defaultModels": [
        "claude-fable-5-1",
        "claude-fable-5",
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
        "claude-opus-4-6",
        "claude-opus-4-5",
        "claude-opus-4-5-20251101",
        "claude-sonnet-5-5",
        "claude-sonnet-5",
        "claude-sonnet-4-6",
        "claude-sonnet-4-5",
        "claude-sonnet-4-5-20250929",
        "claude-haiku-4-5",
        "claude-haiku-4-5-20251001",
        "claude-opus-4-20250514",
        "claude-sonnet-4-20250514"
      ],
      "platforms": [
        { "platform": "anthropic" }
      ],
      "upstream": { "preset": "anthropic", "filterFields": [] }
    }
  ],

  "database": { "schema": "plg_anthropic", "migrations": "migrations/" },

  "userPermissions": [
    {
      "key": "model_catalog:read",
      "defaultRoles": ["admin"],
      "label": { "en": "View model catalog", "zh": "查看模型目录" },
      "description": { "en": "List the Claude models known to the Anthropic plugin.", "zh": "查看 Anthropic 插件提供的 Claude 模型目录。" }
    }
  ],

  "routes": [
    { "method": "GET", "path": "/models", "scope": "admin", "permission": "model_catalog:read" }
  ],

  "resources": { "memoryMB": 64, "cpu": 0.25, "maxThreads": 64, "maxOpenFiles": 256 },

  "hostPermissions": [
    { "id": "platform.register",
      "reason": { "en": "Register the Anthropic API key account type for the built-in anthropic platform", "zh": "为内置 anthropic 平台注册 Anthropic API Key 账号类型" } },
    { "id": "db.schema",
      "reason": { "en": "Store the model catalog", "zh": "保存模型目录" } },
    { "id": "routes.admin",
      "reason": { "en": "Serve the model catalog over the admin API", "zh": "通过管理接口提供模型目录" } },
    { "id": "kv",
      "reason": { "en": "Cache small runtime state", "zh": "缓存少量运行时状态" } }
  ],

  "externalServices": ["api.anthropic.com"]
}
