{
  "apiVersion": 1,
  "key": "anthropic",
  "name": { "en": "Anthropic", "zh": "Anthropic" },
  "description": {
    "en": "Anthropic Claude platform: /v1/messages gateway endpoints, API key accounts, default model prices and a model catalog. Default prices are examples; Anthropic's official pricing prevails.",
    "zh": "Anthropic Claude 平台：/v1/messages 网关端点、API Key 账号、默认模型价格和模型目录。默认价格仅为示例，以 Anthropic 官方公布价格为准。"
  },
  "version": "0.1.0",
  "publisher": "sub2api",
  "icon": "text:A",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    { "id": "platform.adapter.v1" },
    { "id": "http.routes.v1" }
  ],

  "gateway": {
    "endpoints": [
      {
        "id": "messages",
        "method": "POST",
        "path": "/v1/messages",
        "protocol": "anthropic.messages",
        "kind": "proxy",
        "auth": { "headers": ["x-api-key", "authorization"] },
        "request": {
          "modelPath": "model",
          "streamPath": "stream",
          "promptTextPaths": ["system", "messages.#.content"]
        },
        "response": { "stream": "sse", "nonStream": "json" },
        "errorFormat": "anthropic",
        "billing": "usage"
      },
      {
        "id": "count_tokens",
        "method": "POST",
        "path": "/v1/messages/count_tokens",
        "protocol": "anthropic.count_tokens",
        "kind": "proxy",
        "auth": { "headers": ["x-api-key", "authorization"] },
        "request": { "modelPath": "model" },
        "response": { "nonStream": "json" },
        "errorFormat": "anthropic",
        "billing": "free"
      }
    ]
  },

  "platform": {
    "id": "anthropic",
    "label": { "en": "Anthropic", "zh": "Anthropic" },
    "protocols": ["anthropic.messages", "anthropic.count_tokens"],
    "requestFields": ["model"],
    "passHeaders": [
      "anthropic-version",
      "anthropic-beta",
      "anthropic-dangerous-direct-browser-access",
      "user-agent",
      "x-app",
      "x-stainless-arch",
      "x-stainless-helper-method",
      "x-stainless-lang",
      "x-stainless-os",
      "x-stainless-package-version",
      "x-stainless-retry-count",
      "x-stainless-runtime",
      "x-stainless-runtime-version",
      "x-stainless-timeout"
    ],
    "usage": {
      "semantics": "exclusive",
      "sse": [
        {
          "event": "message_start",
          "map": {
            "model": "message.model",
            "input_tokens": "message.usage.input_tokens",
            "cache_read_tokens": "message.usage.cache_read_input_tokens",
            "cache_creation_tokens": "message.usage.cache_creation_input_tokens",
            "cache_creation_1h_tokens": "message.usage.cache_creation.ephemeral_1h_input_tokens"
          }
        },
        {
          "event": "message_delta",
          "map": { "output_tokens": "usage.output_tokens" }
        }
      ],
      "json": {
        "map": {
          "model": "model",
          "input_tokens": "usage.input_tokens",
          "output_tokens": "usage.output_tokens",
          "cache_read_tokens": "usage.cache_read_input_tokens",
          "cache_creation_tokens": "usage.cache_creation_input_tokens",
          "cache_creation_1h_tokens": "usage.cache_creation.ephemeral_1h_input_tokens"
        }
      }
    },
    "stickyRules": [
      {
        "name": "claude-code-session",
        "match": { "protocols": ["anthropic.messages"], "models": ["claude-*"] },
        "keySources": [ { "type": "body", "path": "metadata.user_id" } ],
        "ttlSeconds": 3600,
        "keyIncludes": ["group", "model", "rule"],
        "onFailure": "failover"
      }
    ]
  },

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "API Key", "zh": "API Key" },
      "description": {
        "en": "An Anthropic Console API key, or a key for an Anthropic-compatible endpoint (set Base URL).",
        "zh": "Anthropic 控制台的 API Key，或 Anthropic 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url", "model_mapping"],
      "protocols": [
        { "protocol": "anthropic.messages" },
        { "protocol": "anthropic.count_tokens" }
      ]
    }
  ],

  "pricing": [
    { "model": "claude-fable-5-1*", "mode": "per_token",
      "config": { "p": 10, "c": 50, "cr": 0.25, "cc": 12.5, "cc1h": 20 } },
    { "model": "claude-fable-5*", "mode": "per_token",
      "config": { "p": 10, "c": 50, "cr": 1, "cc": 12.5, "cc1h": 20 } },
    { "model": "claude-opus-5-5*", "mode": "per_token",
      "config": { "p": 4, "c": 20, "cr": 0.2, "cc": 5, "cc1h": 8 } },
    { "model": "claude-opus-5*", "mode": "per_token",
      "config": { "p": 5, "c": 25, "cr": 0.5, "cc": 6.25, "cc1h": 10 } },
    { "model": "claude-opus-4-*", "mode": "per_token",
      "config": { "p": 5, "c": 25, "cr": 0.5, "cc": 6.25, "cc1h": 10 } },
    { "model": "claude-opus-4-1*", "mode": "per_token",
      "config": { "p": 15, "c": 75, "cr": 1.5, "cc": 18.75, "cc1h": 30 } },
    { "model": "claude-opus-4-2*", "mode": "per_token",
      "config": { "p": 15, "c": 75, "cr": 1.5, "cc": 18.75, "cc1h": 30 } },
    { "model": "claude-sonnet-5*", "mode": "per_token",
      "config": { "p": 2, "c": 10, "cr": 0.2, "cc": 2.5, "cc1h": 4 } },
    { "model": "claude-sonnet-4*", "mode": "expression",
      "expression": "len <= 200000 ? tier(\"standard\", p*3 + c*15 + cr*0.3 + cc*3.75 + cc1h*6) : tier(\"long_context\", p*6 + c*22.5 + cr*0.6 + cc*7.5 + cc1h*12)" },
    { "model": "claude-haiku-4-5*", "mode": "per_token",
      "config": { "p": 1, "c": 5, "cr": 0.1, "cc": 1.25, "cc1h": 2 } },
    { "model": "claude-3-5-haiku*", "mode": "per_token",
      "config": { "p": 0.8, "c": 4, "cr": 0.08, "cc": 1, "cc1h": 1.6 } }
  ],

  "database": { "schema": "plg_anthropic", "migrations": "migrations/" },

  "userPermissions": [
    {
      "key": "model_catalog:read",
      "label": { "en": "View model catalog", "zh": "查看模型目录" },
      "description": { "en": "List the Claude models known to the Anthropic plugin.", "zh": "查看 Anthropic 插件提供的 Claude 模型目录。" }
    }
  ],

  "routes": [
    { "method": "GET", "path": "/models", "scope": "admin", "permission": "model_catalog:read" }
  ],

  "ui": {
    "menus": [
      {
        "id": "anthropic-models",
        "section": "plugins",
        "label": { "en": "Model catalog", "zh": "模型目录" },
        "icon": "list",
        "page": "models",
        "permission": "model_catalog:read",
        "order": 100
      }
    ],
    "pages": {
      "models": {
        "type": "table",
        "title": { "en": "Claude model catalog", "zh": "Claude 模型目录" },
        "source": "GET /models",
        "columns": [
          { "key": "model_id", "label": { "en": "Model", "zh": "模型" }, "format": "text" },
          { "key": "display_name", "label": { "en": "Name", "zh": "名称" }, "format": "text" },
          { "key": "context_window", "label": { "en": "Context window", "zh": "上下文窗口" }, "format": "number" },
          { "key": "max_output_tokens", "label": { "en": "Max output", "zh": "最大输出" }, "format": "number" },
          { "key": "status", "label": { "en": "Status", "zh": "状态" }, "format": "badge" }
        ]
      }
    }
  },

  "resources": { "memoryMB": 64, "cpu": 0.25, "maxThreads": 64, "maxOpenFiles": 256 },

  "hostPermissions": [
    { "id": "gateway.endpoint",
      "reason": { "en": "Serve POST /v1/messages and POST /v1/messages/count_tokens", "zh": "提供 POST /v1/messages 与 POST /v1/messages/count_tokens 网关端点" } },
    { "id": "platform.register",
      "reason": { "en": "Register the Anthropic platform and its API key account type", "zh": "注册 Anthropic 平台及其 API Key 账号类型" } },
    { "id": "accounts.credentials", "scope": { "types": "own" },
      "reason": { "en": "Read the API key of accounts of its own account type (Anthropic API Key) to call the upstream API", "zh": "读取本插件账号类型（Anthropic API Key）账号的 API Key 以调用上游接口" } },
    { "id": "db.schema",
      "reason": { "en": "Store the model catalog", "zh": "保存模型目录" } },
    { "id": "routes.admin",
      "reason": { "en": "Serve the model catalog to the console", "zh": "向控制台提供模型目录接口" } },
    { "id": "ui.menu",
      "reason": { "en": "Add the \"Model catalog\" menu", "zh": "添加\"模型目录\"菜单" } },
    { "id": "kv",
      "reason": { "en": "Cache small runtime state", "zh": "缓存少量运行时状态" } }
  ],

  "externalServices": ["api.anthropic.com"]
}
