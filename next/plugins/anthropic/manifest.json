{
  "apiVersion": 1,
  "key": "anthropic",
  "name": { "en": "Anthropic", "zh": "Anthropic" },
  "description": {
    "en": "Anthropic API key account type, default model prices and a model catalog. The anthropic platform and its endpoints are built into the core. Default prices are examples; Anthropic's official pricing prevails.",
    "zh": "Anthropic API Key 账号类型、默认价格与模型目录（anthropic 平台及其端点由核心内置）。默认价格仅为示例，以 Anthropic 官方公布价格为准。"
  },
  "version": "0.1.0",
  "publisher": "sub2api",
  "icon": "text:A",
  "runtime": "grpc",
  "entry": { "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" } },
  "hostCompat": ">=0.1.0 <0.2.0",

  "capabilities": [
    { "id": "platform.adapter.v1" },
    { "id": "http.routes.v1" }
  ],

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "API Key", "zh": "API Key" },
      "description": {
        "en": "An Anthropic Console API key, or a key for an Anthropic-compatible endpoint (set Base URL).",
        "zh": "Anthropic 控制台的 API Key，或 Anthropic 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url", "model_mapping"],
      "platforms": [
        { "platform": "anthropic" }
      ]
    }
  ],

  "pricing": [
    { "model": "claude-fable-5-1*", "mode": "per_token",
      "config": { "p": 10, "c": 50, "cr": 0.25, "cc": 12.5, "cc1h": 20 } },
    { "model": "claude-fable-5*", "mode": "per_token",
      "config": { "p": 10, "c": 50, "cr": 1, "cc": 12.5, "cc1h": 20 } },
    { "model": "claude-opus-5-5*", "mode": "per_token",
      "config": { "p": 4, "c": 20, "cr": 0.2, "cc": 5, "cc1h": 8 } },
    { "model": "claude-opus-5*", "mode": "per_token",
      "config": { "p": 5, "c": 25, "cr": 0.5, "cc": 6.25, "cc1h": 10 } },
    { "model": "claude-opus-4-*", "mode": "per_token",
      "config": { "p": 5, "c": 25, "cr": 0.5, "cc": 6.25, "cc1h": 10 } },
    { "model": "claude-opus-4-1*", "mode": "per_token",
      "config": { "p": 15, "c": 75, "cr": 1.5, "cc": 18.75, "cc1h": 30 } },
    { "model": "claude-opus-4-2*", "mode": "per_token",
      "config": { "p": 15, "c": 75, "cr": 1.5, "cc": 18.75, "cc1h": 30 } },
    { "model": "claude-sonnet-5*", "mode": "per_token",
      "config": { "p": 2, "c": 10, "cr": 0.2, "cc": 2.5, "cc1h": 4 } },
    { "model": "claude-sonnet-4*", "mode": "expression",
      "expression": "len <= 200000 ? tier(\"standard\", p*3 + c*15 + cr*0.3 + cc*3.75 + cc1h*6) : tier(\"long_context\", p*6 + c*22.5 + cr*0.6 + cc*7.5 + cc1h*12)" },
    { "model": "claude-haiku-4-5*", "mode": "per_token",
      "config": { "p": 1, "c": 5, "cr": 0.1, "cc": 1.25, "cc1h": 2 } },
    { "model": "claude-3-5-haiku*", "mode": "per_token",
      "config": { "p": 0.8, "c": 4, "cr": 0.08, "cc": 1, "cc1h": 1.6 } }
  ],

  "database": { "schema": "plg_anthropic", "migrations": "migrations/" },

  "userPermissions": [
    {
      "key": "model_catalog:read",
      "label": { "en": "View model catalog", "zh": "查看模型目录" },
      "description": { "en": "List the Claude models known to the Anthropic plugin.", "zh": "查看 Anthropic 插件提供的 Claude 模型目录。" }
    }
  ],

  "routes": [
    { "method": "GET", "path": "/models", "scope": "admin", "permission": "model_catalog:read" }
  ],

  "ui": {
    "menus": [
      {
        "id": "anthropic-models",
        "section": "plugins",
        "label": { "en": "Model catalog", "zh": "模型目录" },
        "icon": "list",
        "page": "models",
        "permission": "model_catalog:read",
        "order": 100
      }
    ],
    "pages": {
      "models": {
        "type": "table",
        "title": { "en": "Claude model catalog", "zh": "Claude 模型目录" },
        "source": "GET /models",
        "columns": [
          { "key": "model_id", "label": { "en": "Model", "zh": "模型" }, "format": "text" },
          { "key": "display_name", "label": { "en": "Name", "zh": "名称" }, "format": "text" },
          { "key": "context_window", "label": { "en": "Context window", "zh": "上下文窗口" }, "format": "number" },
          { "key": "max_output_tokens", "label": { "en": "Max output", "zh": "最大输出" }, "format": "number" },
          { "key": "status", "label": { "en": "Status", "zh": "状态" }, "format": "badge" }
        ]
      }
    }
  },

  "resources": { "memoryMB": 64, "cpu": 0.25, "maxThreads": 64, "maxOpenFiles": 256 },

  "hostPermissions": [
    { "id": "platform.register",
      "reason": { "en": "Register the Anthropic API key account type for the built-in anthropic platform", "zh": "为内置 anthropic 平台注册 Anthropic API Key 账号类型" } },
    { "id": "accounts.credentials", "scope": { "types": "own" },
      "reason": { "en": "Read the API key of accounts of its own account type (Anthropic API Key) to call the upstream API", "zh": "读取本插件账号类型（Anthropic API Key）账号的 API Key 以调用上游接口" } },
    { "id": "db.schema",
      "reason": { "en": "Store the model catalog", "zh": "保存模型目录" } },
    { "id": "routes.admin",
      "reason": { "en": "Serve the model catalog to the console", "zh": "向控制台提供模型目录接口" } },
    { "id": "ui.menu",
      "reason": { "en": "Add the \"Model catalog\" menu", "zh": "添加\"模型目录\"菜单" } },
    { "id": "kv",
      "reason": { "en": "Cache small runtime state", "zh": "缓存少量运行时状态" } }
  ],

  "externalServices": ["api.anthropic.com"]
}
