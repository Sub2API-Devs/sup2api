{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Gemini API key",
  "required": ["api_key"],
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "pattern": "^(https?://[^\\s?#]+)?$"
    }
  }
}
