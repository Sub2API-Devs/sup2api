{
  "apiVersion": 1,
  "key": "gemini",
  "name": { "en": "Gemini", "zh": "Gemini" },
  "description": {
    "en": "Gemini API key account type. The gemini platform and its endpoints (/v1beta/models/{model}:generateContent, :streamGenerateContent, :countTokens) are built into the core; model prices are set by administrators in the core.",
    "zh": "Gemini API Key 账号类型（gemini 平台及其端点 /v1beta/models/{model}:generateContent、:streamGenerateContent、:countTokens 由核心内置；模型价格由管理员在核心中配置）。"
  },
  "version": "0.3.0",
  "publisher": "sub2api",
  "icon": "assets/gemini-color.svg",
  "runtime": "none",
  "hostCompat": ">=0.1.262 <0.2.0",

  "capabilities": [
    { "id": "platform.adapter.v1" }
  ],

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "Gemini", "zh": "Gemini" },
      "description": {
        "en": "A Google AI Studio (Gemini API) key, or a key for a Gemini-compatible endpoint (set Base URL).",
        "zh": "Google AI Studio（Gemini API）的 Key，或 Gemini 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": {
        "mode": "schema",
        "schema": "forms/apikey.schema.json",
        "uiSchema": "forms/apikey.ui.json"
      },
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url"],
      "guardedSettings": [
        { "field": "base_url", "allowed": ["https://generativelanguage.googleapis.com"] }
      ],
      "defaultModels": [
        "gemini-3.1-pro-preview",
        "gemini-3.1-flash-lite-preview",
        "gemini-3-pro-preview",
        "gemini-3-flash-preview",
        "gemini-2.5-pro",
        "gemini-2.5-flash",
        "gemini-2.5-flash-lite",
        "gemini-2.5-flash-lite-preview-09-2025",
        "gemini-2.0-flash",
        "gemini-2.0-flash-001",
        "gemini-2.0-flash-lite",
        "gemini-2.0-flash-lite-001",
        "gemini-pro-latest",
        "gemini-flash-latest",
        "gemini-flash-lite-latest",
        "gemini-2.5-flash-image",
        "gemini-3-pro-image",
        "gemini-3-pro-image-preview",
        "gemini-3.1-flash-image",
        "gemini-3.1-flash-image-preview",
        "gemma-3-27b-it",
        "gemma-3-12b-it",
        "gemma-3-4b-it",
        "gemma-3-1b-it",
        "gemma-3n-e4b-it",
        "gemma-3n-e2b-it"
      ],
      "platforms": [
        { "platform": "gemini" }
      ],
      "upstream": { "preset": "gemini", "filterFields": [] }
    }
  ],

  "hostPermissions": [
    { "id": "platform.register",
      "reason": { "en": "Register the Gemini API key account type for the built-in gemini platform", "zh": "为内置 gemini 平台注册 Gemini API Key 账号类型" } }
  ],

  "externalServices": ["generativelanguage.googleapis.com"]
}
