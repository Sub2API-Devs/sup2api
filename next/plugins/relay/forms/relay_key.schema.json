{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Claude relay key",
  "required": ["base_url", "api_key"],
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "minLength": 1,
      "pattern": "^https?://[^\\s?#]+$"
    },
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "model_mapping": {
      "type": "object",
      "title": "Model mapping",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "default": {}
    }
  }
}
