# Build context: next/ (see Dockerfile). Keep Go module dirs listed in go.work.
**/node_modules
**/.vite
**/*.test
**/*.exe
**/.env
**/.env.*
!**/.env.example
deploy/keys
e2e/.cache
web/dist
.git
# Independently built CCGateway services are not part of the core image.
# build-go.sh removes these companion modules from its build workspace.
plugins/ccgateway/companions/*
# Shared data contracts are linked into the core, unlike the Worker engine.
!plugins/ccgateway/companions/contracts/
!plugins/ccgateway/companions/contracts/**
# plugins/ccgateway/images/ (runtime image archives, git-ignored) MUST stay in
# the context: build-go.sh packs it into the ccgateway package (§53.10). Only
# the image script's leftover temporary directories are dropped.
plugins/ccgateway/images/.build.*
