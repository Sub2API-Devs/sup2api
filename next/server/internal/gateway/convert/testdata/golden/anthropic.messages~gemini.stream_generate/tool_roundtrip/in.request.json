{
  "model": "gemini-2.5-flash",
  "max_tokens": 512,
  "tools": [
    {
      "name": "get_weather",
      "description": "Current weather",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "get_time",
      "description": "Current time",
      "input_schema": {
        "type": "object",
        "properties": {
          "tz": {
            "type": "string"
          }
        },
        "required": [
          "tz"
        ]
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": "Weather and local time in Paris?"
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "tool_use",
          "id": "toolu_w1",
          "name": "get_weather",
          "input": {
            "city": "Paris"
          }
        },
        {
          "type": "tool_use",
          "id": "toolu_t1",
          "name": "get_time",
          "input": {
            "tz": "Europe/Paris"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_w1",
          "content": "18C, cloudy"
        },
        {
          "type": "tool_result",
          "tool_use_id": "toolu_t1",
          "content": [
            {
              "type": "text",
              "text": "14:05"
            }
          ]
        }
      ]
    },
    {
      "role": "user",
      "content": "Thanks. Tomorrow?"
    }
  ],
  "stream": true
}
