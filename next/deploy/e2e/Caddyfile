{
	admin off
	auto_https off
}

# Keep request retries out of this shared block: writes must never inherit them.
(e2e_backends) {
	lb_policy least_conn
	health_uri /healthz
	health_status 200
	health_interval 1s
	health_timeout 2s
	fail_duration 10s
	max_fails 1
	flush_interval -1
}

# The suite also uses http://caddy:3120 for its recursion protection check.
:3120 {
	handle_path /__node1/* {
		reverse_proxy node-1:8080 {
			flush_interval -1
		}
	}

	handle_path /__node2/* {
		reverse_proxy node-2:8080 {
			flush_interval -1
		}
	}

	handle_path /__mock/* {
		reverse_proxy mock-upstream:8080 {
			flush_interval -1
		}
	}

	handle_path /market/* {
		root * /srv/market
		file_server
	}

	handle {
		@safe_read method GET HEAD
		handle @safe_read {
			reverse_proxy node-1:8080 node-2:8080 {
				import e2e_backends
				lb_try_duration 5s
				lb_try_interval 100ms
				lb_retry_match method GET HEAD
			}
		}
		# Separate handler is deliberate: lb_retry_match alone still allows
		# retries of any method on dial failures. No retries for writes here.
		handle {
			reverse_proxy node-1:8080 node-2:8080 {
				import e2e_backends
			}
		}
	}
}
