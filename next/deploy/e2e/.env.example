E2E_PROJECT=sub2api-next-e2e
E2E_APP_IMAGE=sup2api-e2e:local
E2E_MOCK_IMAGE=sup2api-e2e-mock:local
E2E_VERSION=0.1.0-e2e
E2E_PORT=3120
E2E_PUBLIC_URL=http://127.0.0.1:3120
E2E_ADMIN_EMAIL=admin@sub2api.test

# Optional, used only by test.sh's one-shot Go runner.
E2E_GO_IMAGE=golang:1.27
E2E_LONG=1

# Generate fresh, dedicated E2E values; never reuse the production .env.
# DB password must be URL-safe (hex recommended); master key is 32 bytes base64.
E2E_DB_PASSWORD=
E2E_MASTER_KEY=
E2E_JWT_SECRET=
E2E_ADMIN_PASSWORD=
