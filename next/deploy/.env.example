# Copy to .env (never commit .env). scripts/up.sh creates one with random
# secrets on first run if it does not exist.

# PostgreSQL superuser password (hex/alnum only: it is embedded in a URL).
PG_PASSWORD=change-me

# base64 of exactly 32 random bytes:  head -c 32 /dev/urandom | base64
SUB2API_MASTER_KEY=
# at least 32 bytes:  head -c 32 /dev/urandom | base64
SUB2API_JWT_SECRET=

SUB2API_BOOTSTRAP_ADMIN_EMAIL=admin@sub2api.test
SUB2API_BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# Optional
SUB2API_VERSION=0.1.0-dev
SUB2API_LOG_LEVEL=info
SUB2API_PUBLIC_URL=http://127.0.0.1:3120
NODE_MEM_LIMIT=1g
SUB2API_PLUGIN_MAX_MEMORY_MB=1024

# Leave empty to trust the dev key generated at image build time
# ("<keyId>=<base64 pub>" and [{name,url,public_key}] respectively).
SUB2API_PLUGIN_OFFICIAL_KEYS=
SUB2API_MARKET_SOURCES=
