# Copy to .env. Use the SAME secrets as the existing cluster when migrating.
SHELL_IMAGE=sup2api-shell:local
DATABASE_URL=postgres://sup2api:replace@database.example.com:5432/sup2api?sslmode=require
REDIS_URL=redis://:replace@redis.example.com:6379/0
# Optional, independent random secrets per node (at least 32 bytes).
# Empty uses automatic generation; Redis expiry recreates the registration.
NODE_A_PEER_AUTH_KEY=
NODE_B_PEER_AUTH_KEY=
SUB2API_MASTER_KEY=
SUB2API_JWT_SECRET=
SUB2API_PUBLIC_URL=https://sup2api.example.com
# Plugin signing keys are independent from core release signing keys.
SUB2API_PLUGIN_OFFICIAL_KEYS=
SUB2API_BOOTSTRAP_ADMIN_EMAIL=
SUB2API_BOOTSTRAP_ADMIN_PASSWORD=
