# Copy to .env. Use the SAME secrets as the existing cluster when migrating.
GATEWAY_IMAGE=sup2api-gateway:local
DATABASE_URL=postgres://sup2api:replace@database.example.com:5432/sup2api?sslmode=require
# Any Redis-protocol cache shared by the cluster, Valkey by default (Redis 7+
# works too). valkey:// / valkeys:// (TLS) mean the same as redis:// / rediss://.
# The cache must require a password (requirepass): plugins can reach the
# cluster network. Use a hex password (openssl rand -hex 32) so the URL needs
# no escaping; percent-encode any other reserved character.
REDIS_URL=valkey://:replace@valkey.example.com:6379/0
# Migration only: true lets cores that predate the management token keep using
# the gateway's management socket. Leave empty afterwards.
SUB2API_ALLOW_TOKENLESS_MANAGEMENT=
# Optional, independent random secrets per node (at least 32 bytes).
# Empty uses automatic generation; Redis expiry recreates the registration.
NODE_A_PEER_AUTH_KEY=
NODE_B_PEER_AUTH_KEY=
SUB2API_MASTER_KEY=
SUB2API_JWT_SECRET=
SUB2API_PUBLIC_URL=https://sup2api.example.com
# Plugin signing keys are independent from core release signing keys.
SUB2API_PLUGIN_OFFICIAL_KEYS=
SUB2API_BOOTSTRAP_ADMIN_EMAIL=
SUB2API_BOOTSTRAP_ADMIN_PASSWORD=
