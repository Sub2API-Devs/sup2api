# sup2api：本机节点 sup2api-ccp 优先，不健康时转 ovh 的 sup2api-1（经下方 3141 跳板）
api.prophey.ai {
    reverse_proxy 127.0.0.1:3140 127.0.0.1:3141 {
        lb_policy first
        lb_try_duration 5s
        lb_try_interval 250ms
        health_uri /readyz
        health_interval 5s
        health_timeout 3s
        fail_duration 30s
        flush_interval -1
    }
}
# sup2api 容灾跳板：同一组上游不能混用 http/https，这里转成 HTTPS 到 ovh 的 Caddy
http://:3141 {
    bind 127.0.0.1
    reverse_proxy https://sup2api.15.204.107.38.sslip.io {
        header_up Host sup2api.15.204.107.38.sslip.io
        header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
        flush_interval -1
    }
}
