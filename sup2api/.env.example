# =============================================================================
# Sub2API 本地 Docker Compose 环境变量
# =============================================================================
# 在本目录 sup2api/ 下：
#   cp .env.example .env
#   chmod 600 .env
# 用 openssl rand -hex 32 填 JWT_SECRET / TOTP_ENCRYPTION_KEY / POSTGRES_PASSWORD
#   ../deploy/setup_nats_nsc.sh
#   ./build_all.sh              # 只构建镜像，不启动
#   docker compose up -d        # 启动 postgres/redis/nats/sub2api/ai-gateway
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像与端口
# -----------------------------------------------------------------------------
SUB2API_IMAGE=sub2api:latest
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
AI_GATEWAY_IMAGE=sup2api/ai-gateway:local
NATS_IMAGE=nats:2.11-alpine

# 只绑本机，避免局域网误暴露
BIND_HOST=127.0.0.1
SERVER_PORT=8080
AI_GATEWAY_PORT=9999
NATS_BIND_HOST=127.0.0.1
NATS_PORT=4222

SERVER_MODE=release
RUN_MODE=standard
ENABLE_SERVER_TIMING=false
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# PostgreSQL（必填）
# -----------------------------------------------------------------------------
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# -----------------------------------------------------------------------------
# Redis（本地默认无密码）
# -----------------------------------------------------------------------------
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

# -----------------------------------------------------------------------------
# 管理员（ADMIN_PASSWORD 留空则首次启动写进日志）
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 密钥（必填，重启后必须保持不变）
# openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=
SETUP_MIGRATION_TIMEOUT_SECONDS=0

# -----------------------------------------------------------------------------
# 可选：GitHub / 支付 / OAuth
# -----------------------------------------------------------------------------
UPDATE_GITHUB_TOKEN=
ALIPAY_MOBILE_PRECREATE_DEEP_LINK=
# 容器访问宿主机代理请用 host.docker.internal，不要写 127.0.0.1
UPDATE_PROXY_URL=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_USER_AGENT_VERSION=

# -----------------------------------------------------------------------------
# 安全
# -----------------------------------------------------------------------------
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=

# -----------------------------------------------------------------------------
# 网关调参（沿用官方默认）
# -----------------------------------------------------------------------------
GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
GATEWAY_OPENAI_HTTP2_ENABLED=true
GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true
GATEWAY_OPENAI_HTTP2_FALLBACK_ERROR_THRESHOLD=2
GATEWAY_OPENAI_HTTP2_FALLBACK_WINDOW_SECONDS=60
GATEWAY_OPENAI_HTTP2_FALLBACK_TTL_SECONDS=600
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_FAILURE_THRESHOLD=2
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_WINDOW_SECONDS=60
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_TTL_SECONDS=600
GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
GATEWAY_IMAGE_CONCURRENCY_OVERFLOW_MODE=reject
GATEWAY_IMAGE_CONCURRENCY_WAIT_TIMEOUT_SECONDS=30
GATEWAY_IMAGE_CONCURRENCY_MAX_WAITING_REQUESTS=100

# -----------------------------------------------------------------------------
# AI Gateway / NATS（docker compose up -d 默认一起启动）
# 先：../deploy/setup_nats_nsc.sh
# DATA_PLANE_CONTROL_GRANT_SECRET 不要复用 JWT_SECRET
# openssl rand -hex 32
# -----------------------------------------------------------------------------
DATA_PLANE_CONTROL_GRANT_SECRET=
DATA_PLANE_CONTROL_GRANT_TTL_SECONDS=60
DATA_PLANE_CONTROL_LEASE_TTL_SECONDS=60
# 添加 Worker 时把这个值填进「一次性配对码」，不要去日志里找
# 至少 48 个字符：openssl rand -base64 36
AI_GATEWAY_PAIRING_TOKEN=CHANGE_ME_PAIRING_TOKEN_REPLACE_WITH_OPENSSL_RAND
# 控制面和 Worker 使用同一把管理密钥，各自从 .env 加载，不要在管理页填写
# 至少 32 个字符：openssl rand -base64 32
AI_GATEWAY_MANAGEMENT_KEY=CHANGE_ME_MANAGEMENT_KEY_REPLACE_WITH_OPENSSL_RAND
# Vault 密钥只给 Worker 用。正好 32 字节的 Base64 或 hex：openssl rand -base64 32
AI_GATEWAY_VAULT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_GATEWAY_LEASE_RENEW_INTERVAL=30s
AI_GATEWAY_SETTLEMENT_WAL_MAX_BYTES=1073741824
NATS_SERVER_AUTH_CONFIG=../deploy/nats-auth/nats-server-auth.conf
NATS_CONTROL_CREDENTIALS_FILE=../deploy/nats-auth/control.creds
NATS_ISSUER_PROFILE_FILE=../deploy/nats-auth/issuer-profile.json
# 可选默认值。每个 Worker 的 NATS 地址在「添加 Worker」表单填写，不要只靠这一项。
NATS_WORKER_URL=
NATS_USAGE_STREAM=SUP2API_USAGE
NATS_USAGE_SUBJECT=sup2api.usage.settlements.v1
NATS_USAGE_DURABLE=sup2api-usage-settlement-v1
NATS_USAGE_MAX_AGE_HOURS=24
NATS_USAGE_MAX_BYTES=1073741824
NATS_USAGE_CONSUMERS=8
NATS_MAX_CONNECTIONS=10000
NATS_MAX_PAYLOAD=8MB
NATS_MAX_PENDING=64MB
NATS_JETSTREAM_MAX_MEMORY_STORE=512MB
NATS_JETSTREAM_MAX_FILE_STORE=10GB
NATS_JETSTREAM_SYNC_INTERVAL=30s
